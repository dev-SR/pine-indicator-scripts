//@version=5

// ════════════════════════════════════════════════════════════════════════════
//  CVD Absorption / Exhaustion — v6   (Robust State + Self-Documenting Labels)
//
//  FIXES over v5
//  ─────────────────────────────────────────────────────────────────────────
//  1. PREV-STATE ONLY ADVANCES WHEN dist >= minDist
//     In v5, ANY micro-pivot (even 1 bar away) silently replaced the valid
//     swing reference, so the next comparison was against noise, causing:
//       • Bullish Absorption to miss or misfire (HL/LL comparison corrupted)
//       • Exhaustion signals to appear at wrong bars
//     Fix: the "prev" reference stays pinned to the last VALID swing until a
//     pivot spaced ≥ minDist bars arrives.  Micro-pivots are skipped entirely.
//
//  2. SELF-DOCUMENTING LABELS
//     Every signal label now shows the price structure + CVD direction that
//     triggered it, e.g. "ABS Bear ★★  LH | CVD ↑HH".  You can instantly
//     verify whether the correct pattern was detected without squinting at
//     the chart.
//
//  3. START-OF-LINE MARKER
//     A small "●" label is placed at the LEFT (start) pivot of every signal
//     line so both anchor points are clearly visible on the CVD pane.
//
//  Patterns (all four now fire reliably)
//  ─────────────────────────────────────────────────────────────────────────
//  Bearish Exhaustion  │ Price HH + CVD LH  │ dashed │ gray
//    Buyers push price to a new high, but buying ORDER FLOW peaks lower →
//    conviction is fading.  Reversal risk.
//
//  Bearish Absorption  │ Price LH + CVD HH  │ solid  │ red/magenta
//    Aggressive buyers ram CVD to a new high, but price makes a lower high →
//    a passive SELL-LIMIT WALL absorbed all bids.  Short opportunity.
//
//  Bullish Exhaustion  │ Price LL + CVD HL  │ dashed │ gray
//    Sellers push price to a new low, but selling ORDER FLOW makes a higher
//    low → sellers are losing conviction.  Reversal risk.
//
//  Bullish Absorption  │ Price HL + CVD LL  │ solid  │ teal/cyan
//    Aggressive sellers hammer CVD to a new low, but price holds a higher
//    low → a passive BUY-LIMIT WALL absorbed all offers.  Long opportunity.
//
//  Lines connect (prevPivotBar, prevCVD) → (curPivotBar, curCVD) on the
//  CVD pane.  Labels sit at the RIGHT pivot; a dot marks the LEFT pivot.
// ════════════════════════════════════════════════════════════════════════════

indicator("CVD Abs/Exh — v6",
     overlay          = false,
     format           = format.volume,
     max_lines_count  = 500,
     max_labels_count = 500)

// ─── INPUTS ─────────────────────────────────────────────────────────────────
grp_piv = "Pivot Settings"
lbL     = input.int(3,   "Left Bars",           minval=1, group=grp_piv)
lbR     = input.int(3,   "Right Bars",          minval=1, group=grp_piv)
minDist = input.int(5,   "Min Distance (bars)", minval=1, group=grp_piv)
maxDist = input.int(100, "Max Distance (bars)", minval=1, group=grp_piv)

grp_ma  = "Moving Average"
maLen   = input.int(20, "CVD MA Length", minval=1, group=grp_ma)

grp_ui      = "Display"
showTable   = input.bool(true, "Show Dashboard",    group=grp_ui)
showPivDots = input.bool(true, "Show Pivot Dots",   group=grp_ui)
showFromDot = input.bool(true, "Show Line-Start ●", group=grp_ui)

// ─── CVD  (Bull & Bear Balance via OHLCV approximation) ─────────────────────
rng      = high - low
bullPow  = rng == 0 ? 0.0 : (close - low)
bearPow  = rng == 0 ? 0.0 : (high - close)
totalPwr = bullPow + bearPow
bullVol  = totalPwr == 0 ? volume * 0.5 : volume * (bullPow / totalPwr)
bearVol  = totalPwr == 0 ? volume * 0.5 : volume * (bearPow / totalPwr)
delta    = bullVol - bearVol
cvd      = ta.cum(delta)
cvd_ma   = ta.sma(cvd, maLen)

fill_col = cvd > cvd_ma ? color.new(color.teal, 70) : color.new(color.red, 70)
p_cvd    = plot(cvd,    "Raw CVD", color=color.yellow,               linewidth=2)
p_ma     = plot(cvd_ma, "CVD MA",  color=color.new(color.white, 20), linewidth=1)
fill(p_cvd, p_ma, color=fill_col)
hline(0, color=color.new(color.gray, 65), linestyle=hline.style_dotted)

// ─── PIVOT DETECTION ─────────────────────────────────────────────────────────
//   ta.pivothigh(high, lbL, lbR) fires at bar N when bar (N-lbR) is a
//   local maximum.  At that moment  high[lbR] = the pivot HIGH price
//   and  cvd[lbR]  = the CVD value AT that pivot bar.
pricePH = ta.pivothigh(high, lbL, lbR)
pricePL = ta.pivotlow (low,  lbL, lbR)

// Circles shifted back to the actual pivot bar (offset = -lbR)
plot(showPivDots and not na(pricePH) ? cvd[lbR] : na,
     "Pivot High", color=color.new(color.red,  15),
     style=plot.style_circles, linewidth=3, offset=-lbR)
plot(showPivDots and not na(pricePL) ? cvd[lbR] : na,
     "Pivot Low",  color=color.new(color.lime, 15),
     style=plot.style_circles, linewidth=3, offset=-lbR)

// ─── COLOUR PALETTE ──────────────────────────────────────────────────────────
C_BULL_1 = color.new(#007755, 0)
C_BULL_2 = color.new(#00ffcc, 0)
C_BULL_3 = color.new(#00ffff, 0)
C_BEAR_1 = color.new(#990022, 0)
C_BEAR_2 = color.new(#ff0055, 0)
C_BEAR_3 = color.new(#ff00cc, 0)
C_EXH_1  = color.new(#555555, 0)
C_EXH_2  = color.new(#999999, 0)
C_EXH_3  = color.new(#dddddd, 0)

// ─── NORMALISATION (tier calculation only — not signal conditions) ────────────
cvdRange = math.max(ta.highest(cvd,  maxDist) - ta.lowest(cvd,  maxDist), 1.0)
prcRange = math.max(ta.highest(high, maxDist) - ta.lowest(low,  maxDist), 0.0001)

// ─── SIGNAL REFERENCE STATE ──────────────────────────────────────────────────
//   prevPh* = last VALID price-pivot-HIGH reference (≥ minDist bars old)
//   prevPl* = last VALID price-pivot-LOW  reference (≥ minDist bars old)
//
//   KEY FIX: state only advances when the new pivot is ≥ minDist bars away
//   from the previous one.  Micro-pivots (< minDist) are skipped so they
//   cannot contaminate the reference used in the next comparison.
var int   prevPhBar   = na
var float prevPhPrice = na
var float prevPhCvd   = na

var int   prevPlBar   = na
var float prevPlPrice = na
var float prevPlCvd   = na

// ─── DASHBOARD STATE ─────────────────────────────────────────────────────────
var string dSig  = "—"
var color  dCol  = color.gray
var string dAct  = "—"
var string dQual = "—"
var int    dBar  = na
var int    dTier = na
var bool   dBull = na
var bool   dAbs  = na


// ════════════════════════════════════════════════════════════════════════════
//  BEARISH SIGNALS — every confirmed price PIVOT HIGH
//
//  At confirmation bar N the actual pivot bar is N-lbR:
//    curBar   = bar_index - lbR    ← bar index of the pivot
//    curPrice = high[lbR]          ← price HIGH at that bar
//    curCvd   = cvd[lbR]           ← CVD value  at that bar
//
//  Compare to the PREVIOUS valid pivot high (prevPh*):
//    Price HH + CVD LH  →  BEARISH EXHAUSTION  (buyers losing steam)
//    Price LH + CVD HH  →  BEARISH ABSORPTION  (sell-limit wall)
// ════════════════════════════════════════════════════════════════════════════
if not na(pricePH)
    curBar   = bar_index - lbR
    curPrice = high[lbR]
    curCvd   = cvd[lbR]

    if not na(prevPhBar)
        dist = curBar - prevPhBar

        if dist >= minDist and dist <= maxDist

            // ── Divergence strength tier ─────────────────────────────
            pDiff = math.abs(curPrice - prevPhPrice) / prcRange
            cDiff = math.abs(curCvd   - prevPhCvd)   / cvdRange
            ratio = pDiff > 0.005 ? math.min(cDiff / pDiff, 6.0)
                                  : (cDiff > 0.05 ? 3.0 : 1.0)
            tier  = ratio > 2.2 ? 3 : ratio > 0.9 ? 2 : 1
            lw    = tier == 3 ? 3 : tier == 2 ? 2 : 1
            star  = tier == 3 ? " ★★★" : tier == 2 ? " ★★☆" : " ★☆☆"

            // ── BEARISH EXHAUSTION : Price HH  +  CVD LH ─────────────
            if curPrice > prevPhPrice and curCvd < prevPhCvd
                ec = tier == 3 ? C_EXH_3 : tier == 2 ? C_EXH_2 : C_EXH_1
                line.new(prevPhBar, prevPhCvd, curBar, curCvd,
                     color=ec, width=lw, style=line.style_dashed)
                // End-of-line label at the RIGHT pivot
                label.new(curBar, curCvd,
                     "EXH Bear" + star + "\nPrice HH  |  CVD ↓LH",
                     color=ec, textcolor=color.white,
                     style=label.style_label_down, size=size.small)
                // Start-of-line dot at the LEFT pivot
                if showFromDot
                    label.new(prevPhBar, prevPhCvd, "●",
                         color=color.new(ec, 50), textcolor=color.white,
                         style=label.style_label_down, size=size.tiny)
                dSig  := "Bearish Exhaustion"
                dCol  := ec
                dAct  := "⚠ Tighten longs / Sniper short"
                dQual := tier==3 ? "★★★ Buyers stalling hard"  :
                         tier==2 ? "★★☆ Momentum weakening"    : "★☆☆ Marginal — confirm"
                dBar  := curBar
                dTier := tier
                dBull := false
                dAbs  := false
                alert("BEARISH EXH" + star + " | Price HH | CVD LH | Buyers exhausted",
                     alert.freq_once_per_bar_close)

            // ── BEARISH ABSORPTION : Price LH  +  CVD HH ─────────────
            else if curPrice < prevPhPrice and curCvd > prevPhCvd
                ac = tier == 3 ? C_BEAR_3 : tier == 2 ? C_BEAR_2 : C_BEAR_1
                line.new(prevPhBar, prevPhCvd, curBar, curCvd,
                     color=ac, width=lw, style=line.style_solid)
                label.new(curBar, curCvd,
                     "ABS Bear" + star + "\nPrice LH  |  CVD ↑HH",
                     color=ac, textcolor=color.white,
                     style=label.style_label_down, size=size.small)
                if showFromDot
                    label.new(prevPhBar, prevPhCvd, "●",
                         color=color.new(ac, 50), textcolor=color.white,
                         style=label.style_label_down, size=size.tiny)
                dSig  := "Bearish Absorption"
                dCol  := ac
                dAct  := "✅ SHORT — Sell-limit wall active"
                dQual := tier==3 ? "★★★ Strong wall"       :
                         tier==2 ? "★★☆ Clear absorption"  : "★☆☆ Weak — wait for confirm"
                dBar  := curBar
                dTier := tier
                dBull := false
                dAbs  := true
                alert("BEARISH ABS" + star + " | Price LH | CVD HH | Sell limits absorbing bids",
                     alert.freq_once_per_bar_close)

        // ── KEY FIX: only advance the reference when pivot is far enough ──
        // Micro-pivots (dist < minDist) leave prevPh* unchanged so the next
        // comparison still uses the last meaningful swing high.
        // Pivots beyond maxDist also advance the reference (reset stale refs).
        if dist >= minDist
            prevPhBar   := curBar
            prevPhPrice := curPrice
            prevPhCvd   := curCvd

    else
        // ── First pivot high seen: initialise ────────────────────────
        prevPhBar   := curBar
        prevPhPrice := curPrice
        prevPhCvd   := curCvd


// ════════════════════════════════════════════════════════════════════════════
//  BULLISH SIGNALS — every confirmed price PIVOT LOW
//
//    curBar   = bar_index - lbR    ← pivot bar index
//    curPrice = low[lbR]           ← price LOW  at that bar
//    curCvd   = cvd[lbR]           ← CVD value  at that bar
//
//  Compare to previous valid pivot low (prevPl*):
//    Price LL + CVD HL  →  BULLISH EXHAUSTION  (sellers losing steam)
//    Price HL + CVD LL  →  BULLISH ABSORPTION  (buy-limit wall)
// ════════════════════════════════════════════════════════════════════════════
if not na(pricePL)
    curBar   = bar_index - lbR
    curPrice = low[lbR]
    curCvd   = cvd[lbR]

    if not na(prevPlBar)
        dist = curBar - prevPlBar

        if dist >= minDist and dist <= maxDist

            pDiff = math.abs(curPrice - prevPlPrice) / prcRange
            cDiff = math.abs(curCvd   - prevPlCvd)   / cvdRange
            ratio = pDiff > 0.005 ? math.min(cDiff / pDiff, 6.0)
                                  : (cDiff > 0.05 ? 3.0 : 1.0)
            tier  = ratio > 2.2 ? 3 : ratio > 0.9 ? 2 : 1
            lw    = tier == 3 ? 3 : tier == 2 ? 2 : 1
            star  = tier == 3 ? " ★★★" : tier == 2 ? " ★★☆" : " ★☆☆"

            // ── BULLISH EXHAUSTION : Price LL  +  CVD HL ─────────────
            if curPrice < prevPlPrice and curCvd > prevPlCvd
                ec = tier == 3 ? C_EXH_3 : tier == 2 ? C_EXH_2 : C_EXH_1
                line.new(prevPlBar, prevPlCvd, curBar, curCvd,
                     color=ec, width=lw, style=line.style_dashed)
                label.new(curBar, curCvd,
                     "EXH Bull" + star + "\nPrice LL  |  CVD ↑HL",
                     color=ec, textcolor=color.white,
                     style=label.style_label_up, size=size.small)
                if showFromDot
                    label.new(prevPlBar, prevPlCvd, "●",
                         color=color.new(ec, 50), textcolor=color.white,
                         style=label.style_label_up, size=size.tiny)
                dSig  := "Bullish Exhaustion"
                dCol  := ec
                dAct  := "⚠ Tighten shorts / Sniper long"
                dQual := tier==3 ? "★★★ Sellers stalling hard" :
                         tier==2 ? "★★☆ Momentum weakening"    : "★☆☆ Marginal — confirm"
                dBar  := curBar
                dTier := tier
                dBull := true
                dAbs  := false
                alert("BULLISH EXH" + star + " | Price LL | CVD HL | Sellers exhausted",
                     alert.freq_once_per_bar_close)

            // ── BULLISH ABSORPTION : Price HL  +  CVD LL ─────────────
            else if curPrice > prevPlPrice and curCvd < prevPlCvd
                ac = tier == 3 ? C_BULL_3 : tier == 2 ? C_BULL_2 : C_BULL_1
                line.new(prevPlBar, prevPlCvd, curBar, curCvd,
                     color=ac, width=lw, style=line.style_solid)
                label.new(curBar, curCvd,
                     "ABS Bull" + star + "\nPrice HL  |  CVD ↓LL",
                     color=ac, textcolor=color.white,
                     style=label.style_label_up, size=size.small)
                if showFromDot
                    label.new(prevPlBar, prevPlCvd, "●",
                         color=color.new(ac, 50), textcolor=color.white,
                         style=label.style_label_up, size=size.tiny)
                dSig  := "Bullish Absorption"
                dCol  := ac
                dAct  := "✅ LONG — Buy-limit wall active"
                dQual := tier==3 ? "★★★ Strong wall"       :
                         tier==2 ? "★★☆ Clear absorption"  : "★☆☆ Weak — wait for confirm"
                dBar  := curBar
                dTier := tier
                dBull := true
                dAbs  := true
                alert("BULLISH ABS" + star + " | Price HL | CVD LL | Buy limits absorbing offers",
                     alert.freq_once_per_bar_close)

        if dist >= minDist
            prevPlBar   := curBar
            prevPlPrice := curPrice
            prevPlCvd   := curCvd

    else
        prevPlBar   := curBar
        prevPlPrice := curPrice
        prevPlCvd   := curCvd


// ════════════════════════════════════════════════════════════════════════════
//  TRADE DECISION DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
if showTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 13,
         bgcolor      = color.new(#08080f, 8),
         border_width = 1,
         border_color = color.new(color.gray, 55),
         frame_width  = 1,
         frame_color  = color.new(color.gray, 35))

    // Header
    table.cell(dash, 0, 0, "⚡  CVD  DASHBOARD",
         text_color=color.white, text_size=size.small,
         text_halign=text.align_center, bgcolor=color.new(#1a1a3e, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

    // CVD flow
    tStr = cvd > cvd_ma ? "▲  Bullish Flow" : "▼  Bearish Flow"
    tCol = cvd > cvd_ma ? color.teal : color.red
    table.cell(dash, 0, 1, "CVD Flow", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, tStr,       text_color=tCol,       text_size=size.tiny)

    sp    = cvd - cvd_ma
    spPct = math.abs(cvd_ma) > 0 ? sp / math.abs(cvd_ma) * 100 : 0.0
    spStr = (spPct >= 0 ? "+" : "") + str.tostring(math.round(spPct, 1)) + "%"
    spCol = spPct >= 0 ? color.teal : color.red
    table.cell(dash, 0, 2, "vs MA", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, spStr,   text_color=spCol,      text_size=size.tiny)

    table.cell(dash, 0, 3, "───  Last Signal  ───",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 25),
         text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 3, 1, 3)

    table.cell(dash, 0, 4, "Signal", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, dSig,     text_color=dCol,       text_size=size.tiny)

    stStr = na(dTier) ? "—" :
             dTier==3  ? "★★★  Strong" :
             dTier==2  ? "★★☆  Medium" : "★☆☆  Weak"
    stCol = na(dTier) ? color.gray :
             dTier==3  ? color.lime  :
             dTier==2  ? color.orange : color.new(color.gray, 20)
    table.cell(dash, 0, 5, "Strength", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, stStr,      text_color=stCol,      text_size=size.tiny)

    ageStr = na(dBar) ? "—" : str.tostring(bar_index - dBar) + "  bars ago"
    table.cell(dash, 0, 6, "Age",  text_color=color.gray,  text_size=size.tiny)
    table.cell(dash, 1, 6, ageStr, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 7, "───  Trade Decision  ───",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 25),
         text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 7, 1, 7)

    table.cell(dash, 0, 8, "Action", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, dAct,     text_color=dCol,       text_size=size.tiny)

    table.cell(dash, 0, 9, "Quality", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, dQual,     text_color=dCol,       text_size=size.tiny)

    bool aligned = (dBull == true  and cvd > cvd_ma) or
                   (dBull == false and cvd < cvd_ma)
    alStr = na(dBull) ? "—" : aligned ? "✓  Trend-aligned  ↑ prob" : "✗  Counter-trend  ↓ prob"
    alCol = na(dBull) ? color.gray : aligned ? color.lime : color.orange
    table.cell(dash, 0, 10, "Trend Align", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 10, alStr,         text_color=alCol,      text_size=size.tiny)

    patStr = na(dAbs) ? "—" :
             dAbs     ? "Absorption  →  continuation" : "Exhaustion  →  reversal risk"
    patCol = na(dAbs) ? color.gray : dAbs ? color.lime : color.orange
    table.cell(dash, 0, 11, "Pattern", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 11, patStr,    text_color=patCol,     text_size=size.tiny)

    table.cell(dash, 0, 12,
         "Solid = ABS (entry)  ·  Dashed = EXH (exit / caution)",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 20),
         text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 12, 1, 12)