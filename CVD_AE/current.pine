//@version=5

// ════════════════════════════════════════════════════════════════════════════
//  CVD Absorption / Exhaustion — v6   (Robust State + Self-Documenting Labels)
//
//  FIXES over v5
//  ─────────────────────────────────────────────────────────────────────────
//  1. PREV-STATE ONLY ADVANCES WHEN dist >= minDist
//     In v5, ANY micro-pivot (even 1 bar away) silently replaced the valid
//     swing reference, so the next comparison was against noise, causing:
//       • Bullish Absorption to miss or misfire (HL/LL comparison corrupted)
//       • Exhaustion signals to appear at wrong bars
//     Fix: the "prev" reference stays pinned to the last VALID swing until a
//     pivot spaced ≥ minDist bars arrives.  Micro-pivots are skipped entirely.
//
//  2. SELF-DOCUMENTING LABELS
//     Every signal label now shows the price structure + CVD direction that
//     triggered it, e.g. "ABS Bear ★★  LH | CVD ↑HH".  You can instantly
//     verify whether the correct pattern was detected without squinting at
//     the chart.
//
//  3. START-OF-LINE MARKER
//     A small "●" label is placed at the LEFT (start) pivot of every signal
//     line so both anchor points are clearly visible on the CVD pane.
//
//  Patterns (all four now fire reliably)
//  ─────────────────────────────────────────────────────────────────────────
//  Bearish Exhaustion  │ Price HH + CVD LH  │ dashed │ gray
//    Buyers push price to a new high, but buying ORDER FLOW peaks lower →
//    conviction is fading.  Reversal risk.
//
//  Bearish Absorption  │ Price LH + CVD HH  │ solid  │ red/magenta
//    Aggressive buyers ram CVD to a new high, but price makes a lower high →
//    a passive SELL-LIMIT WALL absorbed all bids.  Short opportunity.
//
//  Bullish Exhaustion  │ Price LL + CVD HL  │ dashed │ gray
//    Sellers push price to a new low, but selling ORDER FLOW makes a higher
//    low → sellers are losing conviction.  Reversal risk.
//
//  Bullish Absorption  │ Price HL + CVD LL  │ solid  │ teal/cyan
//    Aggressive sellers hammer CVD to a new low, but price holds a higher
//    low → a passive BUY-LIMIT WALL absorbed all offers.  Long opportunity.
//
//  Lines connect (prevPivotBar, prevCVD) → (curPivotBar, curCVD) on the
//  CVD pane.  Labels sit at the RIGHT pivot; a dot marks the LEFT pivot.
// ════════════════════════════════════════════════════════════════════════════

indicator("CVD Abs/Exh — v6",
     overlay          = false,
     format           = format.volume,
     max_lines_count  = 500,
     max_labels_count = 500)

// ─── INPUTS ─────────────────────────────────────────────────────────────────
grp_piv = "Pivot Settings"
lbL     = input.int(5,   "Left Bars",           minval=1, group=grp_piv)
lbR     = input.int(3,   "Right Bars",          minval=1, group=grp_piv)
minDist = input.int(5,   "Min Distance (bars)", minval=1, group=grp_piv)
maxDist = input.int(60,  "Max Distance (bars)", minval=1, group=grp_piv)

grp_ma  = "Moving Average"
maLen   = input.int(20, "CVD MA Length", minval=1, group=grp_ma)

grp_ui      = "Display"
showTable   = input.bool(true, "Show Dashboard",    group=grp_ui)
showPivDots = input.bool(true, "Show Pivot Dots",   group=grp_ui)
showFromDot = input.bool(true, "Show Line-Start ●", group=grp_ui)

grp_col = "Colors"
col_cvd       = input.color(color.yellow, "CVD", group=grp_col)
col_cvd_ma    = input.color(color.new(color.white, 20), "CVD MA", group=grp_col)
col_bull_exh  = input.color(color.new(color.green, 50), "Bull Exh", group=grp_col)
col_bull_abs  = input.color(color.new(color.green, 0), "Bull Abs", group=grp_col)
col_bear_exh  = input.color(color.new(color.red, 50), "Bear Exh", group=grp_col)
col_bear_abs  = input.color(color.new(color.red, 0), "Bear Abs", group=grp_col)

// ─── CVD  (Bull & Bear Balance via OHLCV approximation) ─────────────────────
rng      = high - low
bullPow  = rng == 0 ? 0.0 : (close - low)
bearPow  = rng == 0 ? 0.0 : (high - close)
totalPwr = bullPow + bearPow
bullVol  = totalPwr == 0 ? volume * 0.5 : volume * (bullPow / totalPwr)
bearVol  = totalPwr == 0 ? volume * 0.5 : volume * (bearPow / totalPwr)
delta    = bullVol - bearVol
cvd      = ta.cum(delta)
cvd_ma   = ta.sma(cvd, maLen)

fill_col = cvd > cvd_ma ? color.new(color.teal, 70) : color.new(color.red, 70)
p_cvd    = plot(cvd,    "Raw CVD", color=col_cvd,               linewidth=2)
p_ma     = plot(cvd_ma, "CVD MA",  color=col_cvd_ma,            linewidth=1)
fill(p_cvd, p_ma, color=fill_col)
hline(0, color=color.new(color.gray, 65), linestyle=hline.style_dotted)

// ─── PIVOT DETECTION ─────────────────────────────────────────────────────────
// Implementation Strategy: Both Absorption and Exhaustion strictly utilize CVD Pivots.
cvdPH   = ta.pivothigh(cvd,  lbL, lbR)
cvdPL   = ta.pivotlow (cvd,  lbL, lbR)

// Circles shifted back to the actual pivot bar (offset = -lbR)
plot(showPivDots and not na(cvdPH) ? cvd[lbR] : na, "CVD Pivot High", color=color.new(color.red,  35), style=plot.style_circles, linewidth=2, offset=-lbR)
plot(showPivDots and not na(cvdPL) ? cvd[lbR] : na, "CVD Pivot Low",  color=color.new(color.lime, 35), style=plot.style_circles, linewidth=2, offset=-lbR)

// ─── COLOUR PALETTE ──────────────────────────────────────────────────────────
C_BULL_ABS = col_bull_abs
C_BEAR_ABS = col_bear_abs
C_BULL_EXH = col_bull_exh
C_BEAR_EXH = col_bear_exh

// ─── NORMALISATION (tier calculation only — not signal conditions) ────────────
cvdRange = math.max(ta.highest(cvd,  maxDist) - ta.lowest(cvd,  maxDist), 1.0)
prcRange = math.max(ta.highest(high, maxDist) - ta.lowest(low,  maxDist), 0.0001)

// ─── SIGNAL REFERENCE STATE ──────────────────────────────────────────────────
var int   lastPhBar   = na
var float lastPhPrice = na
var float lastPhCvd   = na

var int   lastPlBar   = na
var float lastPlPrice = na
var float lastPlCvd   = na

// ─── DASHBOARD STATE ─────────────────────────────────────────────────────────
var string dSig  = "—"
var color  dCol  = color.gray
var string dAct  = "—"
var string dQual = "—"
var int    dBar  = na
var int    dTier = na
var bool   dBull = na
var bool   dAbs  = na

// ════════════════════════════════════════════════════════════════════════════
//  BEARISH SIGNALS (Anchors to CVD Pivot Highs)
// ════════════════════════════════════════════════════════════════════════════
if not na(cvdPH)
    curBar   = bar_index - lbR
    curPrice = high[lbR]  // Price at the time of the CVD pivot
    curCvd   = cvd[lbR]

    if na(lastPhBar) or (curBar - lastPhBar) >= minDist
        if not na(lastPhBar) and (curBar - lastPhBar) <= maxDist
            pDiff = math.abs(curPrice - lastPhPrice) / prcRange
            cDiff = math.abs(curCvd   - lastPhCvd)   / cvdRange
            score = pDiff + cDiff
            tier  = score >= 0.50 ? 3 : score >= 0.25 ? 2 : 1
            lw    = tier == 3 ? 3 : tier == 2 ? 2 : 1

            bool isExh = curPrice > lastPhPrice and curCvd < lastPhCvd // HH, LH
            bool isAbs = curPrice < lastPhPrice and curCvd > lastPhCvd // LH, HH

            if isExh
                line.new(lastPhBar, lastPhCvd, curBar, curCvd, color=C_BEAR_EXH, width=lw, style=line.style_dashed)
                label.new(curBar, curCvd, "Exhausted Buyers", color=color.new(color.white, 100), textcolor=C_BEAR_EXH, style=label.style_label_down, size=size.small)
                if showFromDot
                    label.new(lastPhBar, lastPhCvd, "●", color=color.new(C_BEAR_EXH, 50), textcolor=color.white, style=label.style_label_down, size=size.small)

                dSig  := "Exhausted Buyers"
                dCol  := C_BEAR_EXH
                dAct  := "⚠ Tighten longs / Sniper short"
                dQual := tier==3 ? "★★★ Buyers stalling hard"  : tier==2 ? "★★☆ Momentum weakening"    : "★☆☆ Marginal — confirm"
                dBar  := curBar
                dTier := tier
                dBull := false
                dAbs  := false
                alert("Exhausted Buyers | Price HH | CVD LH", alert.freq_once_per_bar_close)

            else if isAbs
                line.new(lastPhBar, lastPhCvd, curBar, curCvd, color=C_BEAR_ABS, width=lw, style=line.style_solid)
                label.new(curBar, curCvd, "Buying Pressure Absorbed", color=color.new(color.white, 100), textcolor=C_BEAR_ABS, style=label.style_label_down, size=size.small)
                if showFromDot
                    label.new(lastPhBar, lastPhCvd, "●", color=color.new(C_BEAR_ABS, 50), textcolor=color.white, style=label.style_label_down, size=size.small)

                dSig  := "Buying Pressure Absorbed"
                dCol  := C_BEAR_ABS
                dAct  := "✅ SHORT — Sell-limit wall active"
                dQual := tier==3 ? "★★★ Strong wall"       : tier==2 ? "★★☆ Clear absorption"  : "★☆☆ Weak — wait for confirm"
                dBar  := curBar
                dTier := tier
                dBull := false
                dAbs  := true
                alert("Buying Pressure Absorbed | Price LH | CVD HH", alert.freq_once_per_bar_close)

        lastPhBar   := curBar
        lastPhPrice := curPrice
        lastPhCvd   := curCvd

// ════════════════════════════════════════════════════════════════════════════
//  BULLISH SIGNALS (Anchors to CVD Pivot Lows)
// ════════════════════════════════════════════════════════════════════════════
if not na(cvdPL)
    curBar   = bar_index - lbR
    curPrice = low[lbR]   // Price at the time of the CVD pivot
    curCvd   = cvd[lbR]

    if na(lastPlBar) or (curBar - lastPlBar) >= minDist
        if not na(lastPlBar) and (curBar - lastPlBar) <= maxDist
            pDiff = math.abs(curPrice - lastPlPrice) / prcRange
            cDiff = math.abs(curCvd   - lastPlCvd)   / cvdRange
            score = pDiff + cDiff
            tier  = score >= 0.50 ? 3 : score >= 0.25 ? 2 : 1
            lw    = tier == 3 ? 3 : tier == 2 ? 2 : 1

            bool isExh = curPrice < lastPlPrice and curCvd > lastPlCvd // LL, HL
            bool isAbs = curPrice > lastPlPrice and curCvd < lastPlCvd // HL, LL

            if isExh
                line.new(lastPlBar, lastPlCvd, curBar, curCvd, color=C_BULL_EXH, width=lw, style=line.style_dashed)
                label.new(curBar, curCvd, "Exhausted Sellers", color=color.new(color.white, 100), textcolor=C_BULL_EXH, style=label.style_label_up, size=size.small)
                if showFromDot
                    label.new(lastPlBar, lastPlCvd, "●", color=color.new(C_BULL_EXH, 50), textcolor=color.white, style=label.style_label_up, size=size.small)

                dSig  := "Exhausted Sellers"
                dCol  := C_BULL_EXH
                dAct  := "⚠ Tighten shorts / Sniper long"
                dQual := tier==3 ? "★★★ Sellers stalling hard" : tier==2 ? "★★☆ Momentum weakening"    : "★☆☆ Marginal — confirm"
                dBar  := curBar
                dTier := tier
                dBull := true
                dAbs  := false
                alert("Exhausted Sellers | Price LL | CVD HL", alert.freq_once_per_bar_close)

            else if isAbs
                line.new(lastPlBar, lastPlCvd, curBar, curCvd, color=C_BULL_ABS, width=lw, style=line.style_solid)
                label.new(curBar, curCvd, "Selling Pressure Absorbed", color=color.new(color.white, 100), textcolor=C_BULL_ABS, style=label.style_label_up, size=size.small)
                if showFromDot
                    label.new(lastPlBar, lastPlCvd, "●", color=color.new(C_BULL_ABS, 50), textcolor=color.white, style=label.style_label_up, size=size.small)

                dSig  := "Selling Pressure Absorbed"
                dCol  := C_BULL_ABS
                dAct  := "✅ LONG — Buy-limit wall active"
                dQual := tier==3 ? "★★★ Strong wall"       : tier==2 ? "★★☆ Clear absorption"  : "★☆☆ Weak — wait for confirm"
                dBar  := curBar
                dTier := tier
                dBull := true
                dAbs  := true
                alert("Selling Pressure Absorbed | Price HL | CVD LL", alert.freq_once_per_bar_close)

        lastPlBar   := curBar
        lastPlPrice := curPrice
        lastPlCvd   := curCvd


// ════════════════════════════════════════════════════════════════════════════
//  TRADE DECISION DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
if showTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 13,
         bgcolor      = color.new(#08080f, 8),
         border_width = 1,
         border_color = color.new(color.gray, 55),
         frame_width  = 1,
         frame_color  = color.new(color.gray, 35))

    // Header
    table.cell(dash, 0, 0, "⚡  CVD  DASHBOARD",
         text_color=color.white, text_size=size.normal,
         text_halign=text.align_center, bgcolor=color.new(#1a1a3e, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

    // CVD flow
    tStr = cvd > cvd_ma ? "▲  Bullish Flow" : "▼  Bearish Flow"
    tCol = cvd > cvd_ma ? color.teal : color.red
    table.cell(dash, 0, 1, "CVD Flow", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, tStr,       text_color=tCol,       text_size=size.small)

    sp    = cvd - cvd_ma
    spPct = math.abs(cvd_ma) > 0 ? sp / math.abs(cvd_ma) * 100 : 0.0
    spStr = (spPct >= 0 ? "+" : "") + str.tostring(math.round(spPct, 1)) + "%"
    spCol = spPct >= 0 ? color.teal : color.red
    table.cell(dash, 0, 2, "vs MA", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, spStr,   text_color=spCol,      text_size=size.small)

    table.cell(dash, 0, 3, "───  Last Signal  ───",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 25),
         text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 3, 1, 3)

    table.cell(dash, 0, 4, "Interpretation", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, dSig,             text_color=dCol,       text_size=size.small)

    stStr = na(dTier) ? "—" :
             dTier==3  ? "★★★  Strong" :
             dTier==2  ? "★★☆  Medium" : "★☆☆  Weak"
    stCol = na(dTier) ? color.gray :
             dTier==3  ? color.lime  :
             dTier==2  ? color.orange : color.new(color.gray, 20)
    table.cell(dash, 0, 5, "Strength", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, stStr,      text_color=stCol,      text_size=size.small)

    ageStr = na(dBar) ? "—" : str.tostring(bar_index - dBar) + "  bars ago"
    table.cell(dash, 0, 6, "Age",  text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 6, ageStr, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 7, "───  Trade Decision  ───",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 25),
         text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 7, 1, 7)

    table.cell(dash, 0, 8, "Action", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, dAct,     text_color=dCol,       text_size=size.small)

    table.cell(dash, 0, 9, "Quality", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, dQual,     text_color=dCol,       text_size=size.small)

    bool aligned = (dBull == true  and cvd > cvd_ma) or
                   (dBull == false and cvd < cvd_ma)
    alStr = na(dBull) ? "—" : aligned ? "✓  Trend-aligned  ↑ prob" : "✗  Counter-trend  ↓ prob"
    alCol = na(dBull) ? color.gray : aligned ? color.lime : color.orange
    table.cell(dash, 0, 10, "Trend Align", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 10, alStr,         text_color=alCol,      text_size=size.small)

    patStr = na(dAbs) ? "—" :
             dAbs     ? "Absorption  →  continuation" : "Exhaustion  →  reversal risk"
    patCol = na(dAbs) ? color.gray : dAbs ? color.lime : color.orange
    table.cell(dash, 0, 11, "Pattern", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, patStr,    text_color=patCol,     text_size=size.small)

    table.cell(dash, 0, 12,
         "Solid = ABS (entry)  ·  Dashed = EXH (exit / caution)",
         bgcolor=color.new(#1a1a3e, 0), text_color=color.new(color.gray, 20),
         text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 12, 1, 12)