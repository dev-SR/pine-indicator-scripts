hvnBoxBorder  = input.color(color.new(color.teal, 40), title="HVN Box Border", group=grpHvnLvn)
lvnBoxColor   = input.color(color.new(color.maroon, 80), title="LVN Box Color", group=grpHvnLvn)
lvnBoxBorder  = input.color(color.new(color.maroon, 50), title="LVN Box Border", group=grpHvnLvn)

grpWeek = "Previous Week"
