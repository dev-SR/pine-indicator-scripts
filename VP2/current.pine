grpBoxes   = "Session Boxes"
showNyBox  = input.bool(true,  title="Show NY Session Box",        group=grpBoxes)
nyBoxColor  = input.color(color.new(color.blue,   92), title="NY Box Color",         group=grpBoxes)
nyBoxBorder = input.color(color.new(color.blue,   92), title="NY Box Border",        group=grpBoxes)

showOnBox   = input.bool(true,  title="Show Overnight Session Box", group=grpBoxes)
onBoxColor  = input.color(color.new(color.purple, 92), title="Overnight Box Color",  group=grpBoxes)
onBoxBorder = input.color(color.new(color.purple, 92), title="Overnight Box Border", group=grpBoxes)

showLnBox   = input.bool(false, title="Show London Session Box",    group=grpBoxes)
lnBoxColor  = input.color(color.new(color.green,  92), title="London Box Color",     group=grpBoxes)
lnBoxBorder = input.color(color.new(color.green,  92), title="London Box Border",    group=grpBoxes)

showAsBox   = input.bool(false, title="Show Asia Session Box",      group=grpBoxes)
asBoxColor  = input.color(color.new(color.red,    92), title="Asia Box Color",       group=grpBoxes)
asBoxBorder = input.color(color.new(color.red,    92), title="Asia Box Border",      group=grpBoxes)

// ========================================================================
// TYPES
// ========================================================================
type VolumeZone
    float lo
    float hi
    float zAbs

type ProfileGfx
    polyline fullPoly
    polyline vaPoly
    line     pocLine
    line     vahLine
    line     valLine
    box[]    hvnBoxes
    box[]    lvnBoxes

type ProfileSnap
    int     startIdx
    int     endIdx
    float   dHigh
    float   dLow
    float   rowSize
    float[] rowVols
    float   maxVol
    float   pocPrice
    float   vahPrice
    float   valPrice
    int     upperRow
    int     lowerRow

type SessAccum
    float[] highs
    float[] lows
    float[] vols
    int     startIndex
    int     endIndex

type ProfileState
    string name
    bool show
    color profColor
    color vaColor
    color pocColor
    color vahColor
    color valColor
    int rowsInput
    float vaPct
    float widthPct
    int labelOffset

    float[] highs
    float[] lows
    float[] vols
    int startIndex
    int endIndex

    polyline fullPoly
    polyline vaPoly
    line pocLine
    line vahLine
    line valLine
    label pocLabel
    label vahLabel
    label valLabel
    box[] hvnBoxes
    box[] lvnBoxes

type SessionBox
    box   b
    float h
    float l
    int   startIdx

type DevProfile
    SessAccum accum
    polyline  fullPoly
    polyline  vaPoly
    line      pocLine
    line      vahLine
    line      valLine
    box[]     hvnBoxes
    box[]     lvnBoxes

newDevProfile() =>
    DevProfile.new(SessAccum.new(array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index), na, na, na, na, na, array.new_box(), array.new_box())

newProfileState(string name, bool show, color pc, color vac, color poc, color vah, color val, int rows, float vaPct, float width, int labOff) =>
    ProfileState.new(name, show, pc, vac, poc, vah, val, rows, vaPct, width, labOff, array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index, na, na, na, na, na, na, na, na, array.new_box(), array.new_box())

// ========================================================================
// VARIABLES
// ========================================================================
var ProfileState wkState = newProfileState("PW",  showWk, wkProfColor, wkVaColor, wkPocColor, wkVahColor, wkValColor, wkRows, wkVaPct, wkWidth, 60)
var ProfileState nyState = newProfileState("PNY", showNY, nyProfColor, nyVaColor, nyPocColor, nyVahColor, nyValColor, nyRows, nyVaPct, nyWidth, 40)
var ProfileState onState = newProfileState("POV", showON, onProfColor, onVaColor, onPocColor, onVahColor, onValColor, onRows, onVaPct, onWidth, 20)

var SessionBox nyBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox onBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox lnBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox asBoxState = SessionBox.new(na, 0.0, 0.0, 0)

var array<ProfileGfx> nyHist = array.new<ProfileGfx>()
var array<ProfileGfx> onHist = array.new<ProfileGfx>()
var ProfileSnap nyFrozen = na
var ProfileSnap onFrozen = na
var SessAccum nyAccum = SessAccum.new(array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index)
var SessAccum onAccum = SessAccum.new(array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index)

var DevProfile nyDev = newDevProfile()
var DevProfile onDev = newDevProfile()
var DevProfile lnDev = newDevProfile()
var DevProfile asDev = newDevProfile()

wkState.show := showWk
nyState.show := showNY
onState.show := showON

// ========================================================================
// SESSION DETECTION
// ========================================================================
bool inWeek    = true
bool isNewWeek = ta.change(time("W")) != 0
bool isEndWeek = isNewWeek

bool inNY    = not na(time(timeframe.period, nySessionStr, tzInput))
bool isNewNY = inNY and not inNY[1]
bool isEndNY = not inNY and inNY[1]

bool inON    = not na(time(timeframe.period, onSessionStr, tzInput))
bool isNewON = inON and not inON[1]
bool isEndON = not inON and inON[1]

bool inNY_cs    = not na(time(timeframe.period, nySession, tzInput))
bool isNewNY_cs = inNY_cs and not inNY_cs[1]
bool isEndNY_cs = not inNY_cs and inNY_cs[1]

bool inON_cs    = not na(time(timeframe.period, onSession, tzInput))
bool isNewON_cs = inON_cs and not inON_cs[1]
bool isEndON_cs = not inON_cs and inON_cs[1]

bool inLN_cs    = not na(time(timeframe.period, lnSession, tzInput))
bool isNewLN_cs = inLN_cs and not inLN_cs[1]
bool isEndLN_cs = not inLN_cs and inLN_cs[1]

bool inAS_cs    = not na(time(timeframe.period, asSession, tzInput))
bool isNewAS_cs = inAS_cs and not inAS_cs[1]
bool isEndAS_cs = not inAS_cs and inAS_cs[1]

// ========================================================================
// HVN / LVN ZONE HELPERS
// ========================================================================
deleteZoneBoxes(box[] boxes) =>
    if not na(boxes)
        while array.size(boxes) > 0
            box b = array.shift(boxes)
            if not na(b)
                box.delete(b)
    true

sortZonesDesc(VolumeZone[] zones) =>
    int n = array.size(zones)
    if n > 1
        for i = 1 to n - 1
            VolumeZone key = array.get(zones, i)
            int j = i - 1
            while j >= 0
                if array.get(zones, j).zAbs < key.zAbs
                    array.set(zones, j + 1, array.get(zones, j))
                    j -= 1
                else
                    break
            array.set(zones, j + 1, key)
    true

mergeOverlapZones(VolumeZone[] zones) =>
    VolumeZone[] merged = array.new<VolumeZone>()
    int n = array.size(zones)
    if n == 0
        merged
    else if n == 1
        array.push(merged, array.get(zones, 0))
        merged
    else
        // sort by lo ascending for overlap scan
        for i = 1 to n - 1
            VolumeZone key = array.get(zones, i)
            int j = i - 1
            while j >= 0
                if array.get(zones, j).lo > key.lo
                    array.set(zones, j + 1, array.get(zones, j))
                    j -= 1
                else
                    break
            array.set(zones, j + 1, key)

        VolumeZone cur = array.get(zones, 0)
        for i = 1 to n - 1
            VolumeZone nxt = array.get(zones, i)
            if nxt.lo <= cur.hi
                cur := VolumeZone.new(math.min(cur.lo, nxt.lo), math.max(cur.hi, nxt.hi), math.max(cur.zAbs, nxt.zAbs))
            else
                array.push(merged, cur)
                cur := nxt
        array.push(merged, cur)
        merged

capZones(VolumeZone[] zones, int maxN) =>
    sortZonesDesc(zones)
    while array.size(zones) > maxN
        array.pop(zones)
    true

// Cluster qualifying row indices into padded VolumeZones
clusterZones(int[] idxs, float[] zArr, float dLow, float rowSize, float R, float pad, bool isHvn) =>
    VolumeZone[] out = array.new<VolumeZone>()
    int nIdx = array.size(idxs)
    if nIdx == 0
        out
    else
        int deltaJMax = math.max(1, int(math.ceil((zoneMergePct / 100.0) * R / rowSize)))
        int clusterStart = 0
        for k = 1 to nIdx
            bool split = k == nIdx
            if not split
                int prevJ = array.get(idxs, k - 1)
                int curJ  = array.get(idxs, k)
                split := (curJ - prevJ) > deltaJMax
            if split
                int j0 = array.get(idxs, clusterStart)
                int j1 = array.get(idxs, k - 1)
                float zPk = isHvn ? -1e10 : 1e10
                for t = clusterStart to k - 1
                    float zj = array.get(zArr, array.get(idxs, t))
                    zPk := isHvn ? math.max(zPk, zj) : math.min(zPk, zj)
                float lo = math.max(dLow, dLow + (j0 * rowSize) - pad)
                float hi = math.min(dLow + R, dLow + ((j1 + 1) * rowSize) + pad)
                if hi > lo
                    array.push(out, VolumeZone.new(lo, hi, math.abs(zPk)))
                clusterStart := k
        out

extractZones(float[] rowVols, float dLow, float dHigh, float rowSize, VolumeZone[] hvnOut, VolumeZone[] lvnOut) =>
    array.clear(hvnOut)
    array.clear(lvnOut)
    int rows = array.size(rowVols)
    float R = dHigh - dLow
    if rows <= 1 or rowSize <= 0 or R <= 0
        true
    else
        float sum = 0.0
        for j = 0 to rows - 1
            sum += array.get(rowVols, j)
        float mean = sum / rows
        float varSum = 0.0
        for j = 0 to rows - 1
            float d = array.get(rowVols, j) - mean
            varSum += d * d
        float stdev = math.sqrt(varSum / rows)
        float eps = math.max(stdev, 1e-10)

        float[] zArr = array.new_float(rows, 0.0)
        int[] hvnIdx = array.new_int()
        int[] lvnIdx = array.new_int()
        for j = 0 to rows - 1
            float z = (array.get(rowVols, j) - mean) / eps
            array.set(zArr, j, z)
            if z >= hvnZThresh
                array.push(hvnIdx, j)
            if z <= lvnZThresh
                array.push(lvnIdx, j)

        float pad = (zonePadPct / 100.0) * R
        VolumeZone[] hvnRaw = clusterZones(hvnIdx, zArr, dLow, rowSize, R, pad, true)
        VolumeZone[] lvnRaw = clusterZones(lvnIdx, zArr, dLow, rowSize, R, pad, false)

        VolumeZone[] hvnMerged = mergeOverlapZones(hvnRaw)
        VolumeZone[] lvnMerged = mergeOverlapZones(lvnRaw)
        capZones(hvnMerged, maxHvnZones)
        capZones(lvnMerged, maxLvnZones)

        int nHvn = array.size(hvnMerged)
        if nHvn > 0
            for i = 0 to nHvn - 1
                array.push(hvnOut, array.get(hvnMerged, i))
        int nLvn = array.size(lvnMerged)
        if nLvn > 0
            for i = 0 to nLvn - 1
                array.push(lvnOut, array.get(lvnMerged, i))
        true

drawZoneBoxes(int startIdx, int endIdx, VolumeZone[] zones, bool isHvn, box[] dest) =>
    deleteZoneBoxes(dest)
    int n = array.size(zones)
    if n > 0 and ((isHvn and showHvn) or (not isHvn and showLvn))
        color bg = isHvn ? hvnBoxColor : lvnBoxColor
        color bd = isHvn ? hvnBoxBorder : lvnBoxBorder
        int right = math.max(startIdx, endIdx)
        for i = 0 to n - 1
            VolumeZone z = array.get(zones, i)
            box b = box.new(startIdx, z.hi, right, z.lo, border_color=bd, bgcolor=bg, border_width=1)
            array.push(dest, b)
    true

applyZonesFromSnap(ProfileSnap s, box[] hvnBoxes, box[] lvnBoxes) =>
    VolumeZone[] hvnZ = array.new<VolumeZone>()
    VolumeZone[] lvnZ = array.new<VolumeZone>()
    if not na(s)
        extractZones(s.rowVols, s.dLow, s.dHigh, s.rowSize, hvnZ, lvnZ)
        drawZoneBoxes(s.startIdx, s.endIdx, hvnZ, true, hvnBoxes)
        drawZoneBoxes(s.startIdx, s.endIdx, lvnZ, false, lvnBoxes)
    else
        deleteZoneBoxes(hvnBoxes)
        deleteZoneBoxes(lvnBoxes)
    true

applyZonesFromRows(float[] rowVols, float dLow, float dHigh, float rowSize, int startIdx, int endIdx, box[] hvnBoxes, box[] lvnBoxes) =>
    VolumeZone[] hvnZ = array.new<VolumeZone>()
    VolumeZone[] lvnZ = array.new<VolumeZone>()
    extractZones(rowVols, dLow, dHigh, rowSize, hvnZ, lvnZ)
    drawZoneBoxes(startIdx, endIdx, hvnZ, true, hvnBoxes)
    drawZoneBoxes(startIdx, endIdx, lvnZ, false, lvnBoxes)
    true

// ========================================================================
// FIXED SESSION PROFILE HELPERS
// ========================================================================
deleteProfileGfx(ProfileGfx p) =>
    if not na(p.fullPoly)
        polyline.delete(p.fullPoly)
    if not na(p.vaPoly)
        polyline.delete(p.vaPoly)
    if not na(p.pocLine)
        line.delete(p.pocLine)
    if not na(p.vahLine)
        line.delete(p.vahLine)
    if not na(p.valLine)
        line.delete(p.valLine)
    deleteZoneBoxes(p.hvnBoxes)
    deleteZoneBoxes(p.lvnBoxes)
    true

drawFixedProfile(ProfileSnap s) =>
    int   dayLength    = s.endIdx - s.startIdx
    float maxWidthBars = dayLength * (sessWidth / 100.0)
    int   rows         = array.size(s.rowVols)
    box[] hvnBoxes     = array.new_box()
    box[] lvnBoxes     = array.new_box()

    chart.point[] points = array.new<chart.point>()
    array.push(points, chart.point.from_index(s.startIdx, s.dLow))
    for j = 0 to rows - 1
        float price = s.dLow + (j * s.rowSize)
        float vol   = array.get(s.rowVols, j)
        int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
        array.push(points, chart.point.from_index(s.startIdx + xOffset, price))
    array.push(points, chart.point.from_index(s.startIdx, s.dHigh))
    array.push(points, chart.point.from_index(s.startIdx, s.dLow))
    polyline fullPoly = polyline.new(points, line_color=sessProfColor, closed=true)

    polyline vaPoly = na
    if s.upperRow >= s.lowerRow
        chart.point[] vaPoints = array.new<chart.point>()
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
        for j = s.lowerRow to s.upperRow
            float price = s.dLow + (j * s.rowSize)
            float vol   = array.get(s.rowVols, j)
            int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
            array.push(vaPoints, chart.point.from_index(s.startIdx + xOffset, price))
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.vahPrice))
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
        vaPoly := polyline.new(vaPoints, line_color=sessVaColor, closed=true, fill_color=sessFillVa ? color.new(sessVaColor, sessFillTrans) : na)

    line pocLine = line.new(s.startIdx, s.pocPrice, s.endIdx, s.pocPrice, color=sessPocColor, width=2)
    line vahLine = line.new(s.startIdx, s.vahPrice, s.endIdx, s.vahPrice, color=sessVahColor, style=line.style_dotted)
    line valLine = line.new(s.startIdx, s.valPrice, s.endIdx, s.valPrice, color=sessValColor, style=line.style_dotted)

    applyZonesFromSnap(s, hvnBoxes, lvnBoxes)
    ProfileGfx.new(fullPoly, vaPoly, pocLine, vahLine, valLine, hvnBoxes, lvnBoxes)

buildSnap(SessAccum acc) =>
    ProfileSnap result = na
    if array.size(acc.highs) > 0
        float dHigh   = array.max(acc.highs)
        float dLow    = array.min(acc.lows)
        float rowSize = (dHigh - dLow) / sessRows
        if rowSize > 0
            float[] rowVols = array.new_float(sessRows, 0.0)
            float totalVol  = 0.0
            for i = 0 to array.size(acc.highs) - 1
                float h = array.get(acc.highs, i)
                float l = array.get(acc.lows,  i)
                float v = array.get(acc.vols,  i)
                int startRow    = math.max(0, math.floor((l - dLow) / rowSize))
                int endRow      = math.min(sessRows - 1, math.floor((h - dLow) / rowSize))
                int rowsSpanned = endRow - startRow + 1
                float volPerRow = rowsSpanned > 0 ? v / rowsSpanned : 0.0
                for j = startRow to endRow
                    array.set(rowVols, j, array.get(rowVols, j) + volPerRow)
                    totalVol += volPerRow

            float maxVol = 0.0
            int   pocRow = 0
            for j = 0 to sessRows - 1
                float vol = array.get(rowVols, j)
                if vol > maxVol
                    maxVol := vol
                    pocRow := j

            if maxVol > 0
                float vaTargetVol  = totalVol * (sessVaPct / 100.0)
                float currentVaVol = array.get(rowVols, pocRow)
                int upperRow = pocRow
                int lowerRow = pocRow
                while currentVaVol < vaTargetVol and (upperRow < sessRows - 1 or lowerRow > 0)
                    float upperVol = upperRow < sessRows - 1 ? array.get(rowVols, upperRow + 1) : -1.0
                    float lowerVol = lowerRow > 0 ? array.get(rowVols, lowerRow - 1) : -1.0
                    if upperVol >= lowerVol and upperVol != -1.0
                        upperRow += 1
                        currentVaVol += upperVol
                    else if lowerVol != -1.0
                        lowerRow -= 1
                        currentVaVol += lowerVol

                float pocPrice = dLow + (pocRow * rowSize) + (rowSize / 2)
                float vahPrice = dLow + (upperRow * rowSize) + (rowSize / 2)
                float valPrice = dLow + (lowerRow * rowSize) + (rowSize / 2)
                result := ProfileSnap.new(acc.startIndex, acc.endIndex, dHigh, dLow, rowSize, rowVols, maxVol, pocPrice, vahPrice, valPrice, upperRow, lowerRow)
    result

pushHist(array<ProfileGfx> hist, ProfileSnap snap) =>
    if not na(snap)
        ProfileGfx gfx = drawFixedProfile(snap)
        array.push(hist, gfx)
        while array.size(hist) > sessShowN
            ProfileGfx old = array.shift(hist)
            deleteProfileGfx(old)
    true

finalizeFixedSession(array<ProfileGfx> hist, ProfileSnap frozen, SessAccum acc, bool showHist, bool holdAsPrev) =>
    ProfileSnap newFrozen = frozen
    ProfileSnap snap = buildSnap(acc)
    if not na(snap)
        if showHist and not na(frozen)
            pushHist(hist, frozen)
        newFrozen := holdAsPrev ? snap : na
        if showHist and not holdAsPrev
            pushHist(hist, snap)
    else if not holdAsPrev
        newFrozen := na
    newFrozen

method resetAccum(SessAccum acc) =>
    array.clear(acc.highs)
    array.clear(acc.lows)
    array.clear(acc.vols)
    true

method accumulate(SessAccum acc, bool inSes, bool isNewSes) =>
    if isNewSes
        acc.startIndex := bar_index
        acc.resetAccum()
    if inSes
        array.push(acc.highs, high)
        array.push(acc.lows,  low)
        array.push(acc.vols,  volume)
        acc.endIndex := bar_index
    true

if isEndNY and (showSessNY or showNY)
    nyFrozen := finalizeFixedSession(nyHist, nyFrozen, nyAccum, showSessNY, showNY)
    nyAccum.resetAccum()

if isEndON and (showSessON or showON)
    onFrozen := finalizeFixedSession(onHist, onFrozen, onAccum, showSessON, showON)
    onAccum.resetAccum()

if showSessNY or showNY
    nyAccum.accumulate(inNY, isNewNY)
if showSessON or showON
    onAccum.accumulate(inON, isNewON)

if not showSessNY
    while array.size(nyHist) > 0
        deleteProfileGfx(array.shift(nyHist))
    if not showNY
        nyFrozen := na

if not showSessON
    while array.size(onHist) > 0
        deleteProfileGfx(array.shift(onHist))
    if not showON
        onFrozen := na

// ========================================================================
// DEVELOPING PROFILES (Custom Sessions — update on candle close)
// ========================================================================
method clearDev(DevProfile d) =>
    if not na(d.fullPoly)
        polyline.delete(d.fullPoly)
        d.fullPoly := na
    if not na(d.vaPoly)
        polyline.delete(d.vaPoly)
        d.vaPoly := na
    if not na(d.pocLine)
        line.delete(d.pocLine)
        d.pocLine := na
    if not na(d.vahLine)
        line.delete(d.vahLine)
        d.vahLine := na
    if not na(d.valLine)
        line.delete(d.valLine)
        d.valLine := na
    deleteZoneBoxes(d.hvnBoxes)
    deleteZoneBoxes(d.lvnBoxes)
    true

method redrawDev(DevProfile d) =>
    d.clearDev()
    ProfileSnap s = buildSnap(d.accum)
    if not na(s)
        int   dayLength    = s.endIdx - s.startIdx
        float maxWidthBars = math.max(1, dayLength) * (sessWidth / 100.0)
        int   rows         = array.size(s.rowVols)

        chart.point[] points = array.new<chart.point>()
        array.push(points, chart.point.from_index(s.startIdx, s.dLow))
        for j = 0 to rows - 1
            float price = s.dLow + (j * s.rowSize)
            float vol   = array.get(s.rowVols, j)
            int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
            array.push(points, chart.point.from_index(s.startIdx + xOffset, price))
        array.push(points, chart.point.from_index(s.startIdx, s.dHigh))
        array.push(points, chart.point.from_index(s.startIdx, s.dLow))
        d.fullPoly := polyline.new(points, line_color=sessProfColor, closed=true)

        if s.upperRow >= s.lowerRow
            chart.point[] vaPoints = array.new<chart.point>()
            array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
            for j = s.lowerRow to s.upperRow
                float price = s.dLow + (j * s.rowSize)
                float vol   = array.get(s.rowVols, j)
                int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
                array.push(vaPoints, chart.point.from_index(s.startIdx + xOffset, price))
            array.push(vaPoints, chart.point.from_index(s.startIdx, s.vahPrice))
            array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
            d.vaPoly := polyline.new(vaPoints, line_color=sessVaColor, closed=true, fill_color=sessFillVa ? color.new(sessVaColor, sessFillTrans) : na)

        d.pocLine := line.new(s.startIdx, s.pocPrice, s.endIdx, s.pocPrice, color=sessPocColor, width=2)
        d.vahLine := line.new(s.startIdx, s.vahPrice, s.endIdx, s.vahPrice, color=sessVahColor, style=line.style_dotted)
        d.valLine := line.new(s.startIdx, s.valPrice, s.endIdx, s.valPrice, color=sessValColor, style=line.style_dotted)

        applyZonesFromSnap(s, d.hvnBoxes, d.lvnBoxes)
    true

method processDev(DevProfile d, bool inSes, bool isNewSes, bool isEndSes) =>
    if not showDevProf
        d.clearDev()
        d.accum.resetAccum()
    else
        if isEndSes
            d.clearDev()
            d.accum.resetAccum()
        if isNewSes
            d.accum.startIndex := bar_index
            d.accum.resetAccum()
            d.clearDev()
        if inSes and barstate.isconfirmed
            array.push(d.accum.highs, high)
            array.push(d.accum.lows,  low)
            array.push(d.accum.vols,  volume)
            d.accum.endIndex := bar_index
            d.redrawDev()
    true

nyDev.processDev(inNY_cs, isNewNY_cs, isEndNY_cs)
onDev.processDev(inON_cs, isNewON_cs, isEndON_cs)
lnDev.processDev(inLN_cs, isNewLN_cs, isEndLN_cs)
asDev.processDev(inAS_cs, isNewAS_cs, isEndAS_cs)

// ========================================================================
// PREVIOUS WEEK / NY / ON (labeled, extend.right)
// ========================================================================
method clearGfx(ProfileState state) =>
    if not na(state.fullPoly)
        polyline.delete(state.fullPoly)
        state.fullPoly := na
    if not na(state.vaPoly)
        polyline.delete(state.vaPoly)
        state.vaPoly := na
    if not na(state.pocLine)
        line.delete(state.pocLine)
        state.pocLine := na
    if not na(state.vahLine)
        line.delete(state.vahLine)
        state.vahLine := na
    if not na(state.valLine)
        line.delete(state.valLine)
        state.valLine := na
    if not na(state.pocLabel)
        label.delete(state.pocLabel)
        state.pocLabel := na
    if not na(state.vahLabel)
        label.delete(state.vahLabel)
        state.vahLabel := na
    if not na(state.valLabel)
        label.delete(state.valLabel)
        state.valLabel := na
    deleteZoneBoxes(state.hvnBoxes)
    deleteZoneBoxes(state.lvnBoxes)
    true

method processSession(ProfileState state, bool inSes, bool isNewSes, bool isEndSes) =>
    if not state.show
        state.clearGfx()
        array.clear(state.highs)
        array.clear(state.lows)
        array.clear(state.vols)
    else
        if isEndSes
            if array.size(state.highs) > 0
                float dHigh   = array.max(state.highs)
                float dLow    = array.min(state.lows)
                float rowSize = (dHigh - dLow) / state.rowsInput

                if rowSize > 0
                    float[] rowVols = array.new_float(state.rowsInput, 0.0)
                    float totalVol  = 0.0

                    for i = 0 to array.size(state.highs) - 1
                        float h = array.get(state.highs, i)
                        float l = array.get(state.lows,  i)
                        float v = array.get(state.vols,  i)

                        int startRow    = math.max(0, math.floor((l - dLow) / rowSize))
                        int endRow      = math.min(state.rowsInput - 1, math.floor((h - dLow) / rowSize))
                        int rowsSpanned = endRow - startRow + 1
                        float volPerRow = rowsSpanned > 0 ? v / rowsSpanned : 0

                        for j = startRow to endRow
                            array.set(rowVols, j, array.get(rowVols, j) + volPerRow)
                            totalVol += volPerRow

                    float maxVol = 0.0
                    int   pocRow = 0
                    for j = 0 to state.rowsInput - 1
                        float vol = array.get(rowVols, j)
                        if vol > maxVol
                            maxVol := vol
                            pocRow := j

                    float vaTargetVol  = totalVol * (state.vaPct / 100.0)
                    float currentVaVol = array.get(rowVols, pocRow)
                    int upperRow = pocRow
                    int lowerRow = pocRow

                    while currentVaVol < vaTargetVol and (upperRow < state.rowsInput - 1 or lowerRow > 0)
                        float upperVol = upperRow < state.rowsInput - 1 ? array.get(rowVols, upperRow + 1) : -1.0
                        float lowerVol = lowerRow > 0 ? array.get(rowVols, lowerRow - 1) : -1.0
                        if upperVol >= lowerVol and upperVol != -1.0
                            upperRow += 1
                            currentVaVol += upperVol
                        else if lowerVol != -1.0
                            lowerRow -= 1
                            currentVaVol += lowerVol

                    float pocPrice = dLow + (pocRow * rowSize) + (rowSize / 2)
                    float vahPrice = dLow + (upperRow * rowSize) + (rowSize / 2)
                    float valPrice = dLow + (lowerRow * rowSize) + (rowSize / 2)

                    int   dayLength    = state.endIndex - state.startIndex + 1
                    float maxWidthBars = dayLength * (state.widthPct / 100.0)

                    state.clearGfx()

                    chart.point[] points = array.new<chart.point>()
                    array.push(points, chart.point.from_index(state.startIndex, dLow))
                    for j = 0 to state.rowsInput - 1
                        float price = dLow + (j * rowSize)
                        float vol   = array.get(rowVols, j)
                        int xOffset = math.round((vol / maxVol) * maxWidthBars)
                        array.push(points, chart.point.from_index(state.startIndex + xOffset, price))
                    array.push(points, chart.point.from_index(state.startIndex, dHigh))
                    array.push(points, chart.point.from_index(state.startIndex, dLow))
                    state.fullPoly := polyline.new(points, line_color=state.profColor, closed=true)

                    if upperRow >= lowerRow
                        chart.point[] vaPoints = array.new<chart.point>()
                        array.push(vaPoints, chart.point.from_index(state.startIndex, valPrice))
                        for j = lowerRow to upperRow
                            float price = dLow + (j * rowSize)
                            float vol   = array.get(rowVols, j)
                            int xOffset = math.round((vol / maxVol) * maxWidthBars)
                            array.push(vaPoints, chart.point.from_index(state.startIndex + xOffset, price))
                        array.push(vaPoints, chart.point.from_index(state.startIndex, vahPrice))
                        array.push(vaPoints, chart.point.from_index(state.startIndex, valPrice))
                        state.vaPoly := polyline.new(vaPoints, line_color=state.vaColor, closed=true, fill_color=color.new(state.vaColor, 85))

                    state.pocLine := line.new(state.startIndex, pocPrice, bar_index, pocPrice, color=state.pocColor, width=2, extend=extend.right)
                    state.vahLine := line.new(state.startIndex, vahPrice, bar_index, vahPrice, color=state.vahColor, width=1, style=line.style_dashed, extend=extend.right)
                    state.valLine := line.new(state.startIndex, valPrice, bar_index, valPrice, color=state.valColor, width=1, style=line.style_dashed, extend=extend.right)

                    string pText = state.name + " POC (" + str.tostring(pocPrice, format.mintick) + ")"
                    string hText = state.name + " VAH (" + str.tostring(vahPrice, format.mintick) + ")"
                    string lText = state.name + " VAL (" + str.tostring(valPrice, format.mintick) + ")"

                    state.pocLabel := label.new(bar_index + state.labelOffset, pocPrice, pText, color=color.new(state.pocColor, 92), textcolor=state.pocColor, style=label.style_label_lower_left, size=size.small)
                    state.vahLabel := label.new(bar_index + state.labelOffset, vahPrice, hText, color=color.new(state.vahColor, 92), textcolor=state.vahColor, style=label.style_label_lower_left, size=size.small)
                    state.valLabel := label.new(bar_index + state.labelOffset, valPrice, lText, color=color.new(state.valColor, 92), textcolor=state.valColor, style=label.style_label_lower_left, size=size.small)

                    // HVN/LVN boxes confined to session window (start → end), not extend.right
                    applyZonesFromRows(rowVols, dLow, dHigh, rowSize, state.startIndex, state.endIndex, state.hvnBoxes, state.lvnBoxes)

            array.clear(state.highs)
            array.clear(state.lows)
            array.clear(state.vols)

        if isNewSes
            state.startIndex := bar_index
            array.clear(state.highs)
            array.clear(state.lows)
            array.clear(state.vols)

        if inSes
            array.push(state.highs, high)
            array.push(state.lows,  low)
            array.push(state.vols,  volume)
            state.endIndex := bar_index

        if not na(state.pocLabel)
            label.set_x(state.pocLabel, bar_index + state.labelOffset)
        if not na(state.vahLabel)
            label.set_x(state.vahLabel, bar_index + state.labelOffset)
        if not na(state.valLabel)
            label.set_x(state.valLabel, bar_index + state.labelOffset)
    true

wkState.processSession(inWeek, isNewWeek, isEndWeek)
nyState.processSession(inNY,   isNewNY,   isEndNY)
onState.processSession(inON,   isNewON,   isEndON)

// ========================================================================
// SESSION BOXES
// ========================================================================
method updateBox(SessionBox sb, bool show, bool inSes, bool isNewSes, color bgColor, color borderColor) =>
    if show and isNewSes
        sb.h        := high
        sb.l        := low
        sb.startIdx := bar_index
        sb.b        := box.new(sb.startIdx, sb.h, bar_index, sb.l, border_color=borderColor, bgcolor=bgColor)

    if show and inSes and not isNewSes
        sb.h := math.max(sb.h, high)
        sb.l := math.min(sb.l, low)
        if not na(sb.b)
            box.set_top(sb.b,    sb.h)
            box.set_bottom(sb.b, sb.l)
            box.set_right(sb.b,  bar_index)
    true

nyBoxState.updateBox(showNyBox, inNY_cs, isNewNY_cs, nyBoxColor, nyBoxBorder)
onBoxState.updateBox(showOnBox, inON_cs, isNewON_cs, onBoxColor, onBoxBorder)
lnBoxState.updateBox(showLnBox, inLN_cs, isNewLN_cs, lnBoxColor, lnBoxBorder)
asBoxState.updateBox(showAsBox, inAS_cs, isNewAS_cs, asBoxColor, asBoxBorder)
