//@version=5
indicator("Daily Volume + TPO Profile", overlay=true, max_lines_count=500, max_polylines_count=100, max_boxes_count=500, max_labels_count=50)

// ========================================================================
// INPUTS
// ========================================================================
grp4 = "Custom Sessions"
nySession = input.string("0800-1700", title="New York Session", group=grp4)
onSession = input.string("1700-0800", title="Overnight Session", group=grp4)
lnSession = input.string("0300-1200", title="London Session", group=grp4)
asSession = input.string("1900-0400", title="Asia Session", group=grp4)
tzInput   = input.string("America/New_York", title="Timezone", group=grp4)

grpSessProf = "Session Profiles"
showSessNY   = input.bool(true, title="Show NY Session Profiles", group=grpSessProf)
showSessON   = input.bool(true, title="Show ON Session Profiles", group=grpSessProf)
sessShowN    = input.int(8, title="Show Last N Sessions (each)", minval=1, maxval=20, group=grpSessProf)
sessRows     = input.int(200, title="Rows", minval=10, maxval=1000, group=grpSessProf)
sessVaPct    = input.float(68, title="VA %", group=grpSessProf)
sessWidth    = input.float(50, title="Width %", group=grpSessProf)
sessProfColor = input.color(color.new(#747474, 0), title="Profile Color", group=grpSessProf)
sessVaColor   = input.color(color.new(#ffffff, 18), title="VA Profile Color", group=grpSessProf)
sessPocColor  = input.color(color.orange, title="POC Color", group=grpSessProf)
sessVahColor  = input.color(color.red, title="VAH Color", group=grpSessProf)
sessValColor  = input.color(color.green, title="VAL Color", group=grpSessProf)
sessFillVa    = input.bool(true, title="Fill Value Area", group=grpSessProf)
sessFillTrans = input.int(85, title="VA Fill Transparency", minval=0, maxval=100, group=grpSessProf)

grpWeek = "Previous Week"
showWk       = input.bool(true, title="Show Previous Week", group=grpWeek)
wkProfColor  = input.color(color.new(color.blue, 70), title="Profile Color", group=grpWeek)
wkVaColor    = input.color(color.new(color.purple, 70), title="VA Profile Color", group=grpWeek)
wkPocColor   = input.color(color.orange, title="POC Color", group=grpWeek)
wkVahColor   = input.color(color.red, title="VAH Color", group=grpWeek)
wkValColor   = input.color(color.green, title="VAL Color", group=grpWeek)
wkRows       = input.int(1000, title="Rows", group=grpWeek)
wkVaPct      = input.float(68, title="VA %", group=grpWeek)
wkWidth      = input.float(30, title="Width %", group=grpWeek)

grpNY = "Previous NY RTH"
showNY       = input.bool(true, title="Show Previous NY RTH", group=grpNY)
nySessionStr = input.string("0930-1600", title="NY Session", group=grpNY)
nyProfColor  = input.color(color.new(color.blue,70), title="Profile Color", group=grpNY)
nyVaColor    = input.color(color.new(color.blue, 30), title="VA Profile Color", group=grpNY)
nyPocColor   = input.color(color.orange, title="POC Color", group=grpNY)
nyVahColor   = input.color(color.red, title="VAH Color", group=grpNY)
nyValColor   = input.color(color.green, title="VAL Color", group=grpNY)
nyRows       = input.int(1000, title="Rows", group=grpNY)
nyVaPct      = input.float(68, title="VA %", group=grpNY)
nyWidth      = input.float(30, title="Width %", group=grpNY)

grpON = "Previous Overnight"
showON       = input.bool(true, title="Show Previous Overnight", group=grpON)
onSessionStr = input.string("1600-0930", title="ON Session", group=grpON)
onProfColor  = input.color(color.new(color.purple, 70), title="Profile Color", group=grpON)
onVaColor    = input.color(color.new(color.purple, 30), title="VA Profile Color", group=grpON)
onPocColor   = input.color(color.orange, title="POC Color", group=grpON)
onVahColor   = input.color(color.red, title="VAH Color", group=grpON)
onValColor   = input.color(color.green, title="VAL Color", group=grpON)
onRows       = input.int(1000, title="Rows", group=grpON)
onVaPct      = input.float(68, title="VA %", group=grpON)
onWidth      = input.float(30, title="Width %", group=grpON)

grpBoxes   = "Session Boxes"
showNyBox  = input.bool(true,  title="Show NY Session Box",        group=grpBoxes)
nyBoxColor  = input.color(color.new(color.blue,   92), title="NY Box Color",         group=grpBoxes)
nyBoxBorder = input.color(color.new(color.blue,   92), title="NY Box Border",        group=grpBoxes)

showOnBox   = input.bool(true,  title="Show Overnight Session Box", group=grpBoxes)
onBoxColor  = input.color(color.new(color.purple, 92), title="Overnight Box Color",  group=grpBoxes)
onBoxBorder = input.color(color.new(color.purple, 92), title="Overnight Box Border", group=grpBoxes)

showLnBox   = input.bool(false, title="Show London Session Box",    group=grpBoxes)
lnBoxColor  = input.color(color.new(color.green,  92), title="London Box Color",     group=grpBoxes)
lnBoxBorder = input.color(color.new(color.green,  92), title="London Box Border",    group=grpBoxes)

showAsBox   = input.bool(false, title="Show Asia Session Box",      group=grpBoxes)
asBoxColor  = input.color(color.new(color.red,    92), title="Asia Box Color",       group=grpBoxes)
asBoxBorder = input.color(color.new(color.red,    92), title="Asia Box Border",      group=grpBoxes)

// ========================================================================
// TYPES
// ========================================================================
type ProfileGfx
    polyline fullPoly
    polyline vaPoly
    line     pocLine
    line     vahLine
    line     valLine

type ProfileSnap
    int     startIdx
    int     endIdx
    float   dHigh
    float   dLow
    float   rowSize
    float[] rowVols
    float   maxVol
    float   pocPrice
    float   vahPrice
    float   valPrice
    int     upperRow
    int     lowerRow

type SessAccum
    float[] highs
    float[] lows
    float[] vols
    int     startIndex
    int     endIndex

type ProfileState
    string name
    bool show
    color profColor
    color vaColor
    color pocColor
    color vahColor
    color valColor
    int rowsInput
    float vaPct
    float widthPct
    int labelOffset

    float[] highs
    float[] lows
    float[] vols
    int startIndex
    int endIndex

    polyline fullPoly
    polyline vaPoly
    line pocLine
    line vahLine
    line valLine
    label pocLabel
    label vahLabel
    label valLabel

type SessionBox
    box   b
    float h
    float l
    int   startIdx

// ========================================================================
// VARIABLES
// ========================================================================
var ProfileState wkState = ProfileState.new("PW",  showWk, wkProfColor, wkVaColor, wkPocColor, wkVahColor, wkValColor, wkRows, wkVaPct, wkWidth, 60, array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index, na, na, na, na, na, na, na, na)
var ProfileState nyState = ProfileState.new("PNY", showNY, nyProfColor, nyVaColor, nyPocColor, nyVahColor, nyValColor, nyRows, nyVaPct, nyWidth, 40, array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index, na, na, na, na, na, na, na, na)
var ProfileState onState = ProfileState.new("POV", showON, onProfColor, onVaColor, onPocColor, onVahColor, onValColor, onRows, onVaPct, onWidth, 20, array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index, na, na, na, na, na, na, na, na)

var SessionBox nyBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox onBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox lnBoxState = SessionBox.new(na, 0.0, 0.0, 0)
var SessionBox asBoxState = SessionBox.new(na, 0.0, 0.0, 0)

// Fixed session-profile history (label-less, session-bounded lines)
var array<ProfileGfx> nyHist = array.new<ProfileGfx>()
var array<ProfileGfx> onHist = array.new<ProfileGfx>()
var ProfileSnap nyFrozen = na
var ProfileSnap onFrozen = na
var SessAccum nyAccum = SessAccum.new(array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index)
var SessAccum onAccum = SessAccum.new(array.new_float(), array.new_float(), array.new_float(), bar_index, bar_index)

wkState.show := showWk
nyState.show := showNY
onState.show := showON

// ========================================================================
// SESSION DETECTION
// ========================================================================
bool inWeek    = true
bool isNewWeek = ta.change(time("W")) != 0
bool isEndWeek = isNewWeek

bool inNY    = not na(time(timeframe.period, nySessionStr, tzInput))
bool isNewNY = inNY and not inNY[1]
bool isEndNY = not inNY and inNY[1]

bool inON    = not na(time(timeframe.period, onSessionStr, tzInput))
bool isNewON = inON and not inON[1]
bool isEndON = not inON and inON[1]

// ========================================================================
// FIXED SESSION PROFILE HELPERS
// ========================================================================
deleteProfileGfx(ProfileGfx p) =>
    if not na(p.fullPoly)
        polyline.delete(p.fullPoly)
    if not na(p.vaPoly)
        polyline.delete(p.vaPoly)
    if not na(p.pocLine)
        line.delete(p.pocLine)
    if not na(p.vahLine)
        line.delete(p.vahLine)
    if not na(p.valLine)
        line.delete(p.valLine)

drawFixedProfile(ProfileSnap s) =>
    int   dayLength    = s.endIdx - s.startIdx
    float maxWidthBars = dayLength * (sessWidth / 100.0)
    int   rows         = array.size(s.rowVols)

    chart.point[] points = array.new<chart.point>()
    array.push(points, chart.point.from_index(s.startIdx, s.dLow))
    for j = 0 to rows - 1
        float price = s.dLow + (j * s.rowSize)
        float vol   = array.get(s.rowVols, j)
        int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
        array.push(points, chart.point.from_index(s.startIdx + xOffset, price))
    array.push(points, chart.point.from_index(s.startIdx, s.dHigh))
    array.push(points, chart.point.from_index(s.startIdx, s.dLow))
    polyline fullPoly = polyline.new(points, line_color=sessProfColor, closed=true)

    polyline vaPoly = na
    if s.upperRow >= s.lowerRow
        chart.point[] vaPoints = array.new<chart.point>()
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
        for j = s.lowerRow to s.upperRow
            float price = s.dLow + (j * s.rowSize)
            float vol   = array.get(s.rowVols, j)
            int xOffset = math.round((vol / s.maxVol) * maxWidthBars)
            array.push(vaPoints, chart.point.from_index(s.startIdx + xOffset, price))
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.vahPrice))
        array.push(vaPoints, chart.point.from_index(s.startIdx, s.valPrice))
        vaPoly := polyline.new(vaPoints, line_color=sessVaColor, closed=true, fill_color=sessFillVa ? color.new(sessVaColor, sessFillTrans) : na)

    // Lines confined to session window — no extend, no labels
    line pocLine = line.new(s.startIdx, s.pocPrice, s.endIdx, s.pocPrice, color=sessPocColor, width=2)
    line vahLine = line.new(s.startIdx, s.vahPrice, s.endIdx, s.vahPrice, color=sessVahColor, style=line.style_dotted)
    line valLine = line.new(s.startIdx, s.valPrice, s.endIdx, s.valPrice, color=sessValColor, style=line.style_dotted)

    ProfileGfx.new(fullPoly, vaPoly, pocLine, vahLine, valLine)

buildSnap(SessAccum acc) =>
    ProfileSnap result = na
    if array.size(acc.highs) > 0
        float dHigh   = array.max(acc.highs)
        float dLow    = array.min(acc.lows)
        float rowSize = (dHigh - dLow) / sessRows
        if rowSize > 0
            float[] rowVols = array.new_float(sessRows, 0.0)
            float totalVol  = 0.0
            for i = 0 to array.size(acc.highs) - 1
                float h = array.get(acc.highs, i)
                float l = array.get(acc.lows,  i)
                float v = array.get(acc.vols,  i)
                int startRow    = math.max(0, math.floor((l - dLow) / rowSize))
                int endRow      = math.min(sessRows - 1, math.floor((h - dLow) / rowSize))
                int rowsSpanned = endRow - startRow + 1
                float volPerRow = rowsSpanned > 0 ? v / rowsSpanned : 0.0
                for j = startRow to endRow
                    array.set(rowVols, j, array.get(rowVols, j) + volPerRow)
                    totalVol += volPerRow

            float maxVol = 0.0
            int   pocRow = 0
            for j = 0 to sessRows - 1
                float vol = array.get(rowVols, j)
                if vol > maxVol
                    maxVol := vol
                    pocRow := j

            if maxVol > 0
                float vaTargetVol  = totalVol * (sessVaPct / 100.0)
                float currentVaVol = array.get(rowVols, pocRow)
                int upperRow = pocRow
                int lowerRow = pocRow
                while currentVaVol < vaTargetVol and (upperRow < sessRows - 1 or lowerRow > 0)
                    float upperVol = upperRow < sessRows - 1 ? array.get(rowVols, upperRow + 1) : -1.0
                    float lowerVol = lowerRow > 0 ? array.get(rowVols, lowerRow - 1) : -1.0
                    if upperVol >= lowerVol and upperVol != -1.0
                        upperRow += 1
                        currentVaVol += upperVol
                    else if lowerVol != -1.0
                        lowerRow -= 1
                        currentVaVol += lowerVol

                float pocPrice = dLow + (pocRow * rowSize) + (rowSize / 2)
                float vahPrice = dLow + (upperRow * rowSize) + (rowSize / 2)
                float valPrice = dLow + (lowerRow * rowSize) + (rowSize / 2)
                result := ProfileSnap.new(acc.startIndex, acc.endIndex, dHigh, dLow, rowSize, rowVols, maxVol, pocPrice, vahPrice, valPrice, upperRow, lowerRow)
    result

pushHist(array<ProfileGfx> hist, ProfileSnap snap) =>
    if not na(snap)
        ProfileGfx gfx = drawFixedProfile(snap)
        array.push(hist, gfx)
        while array.size(hist) > sessShowN
            ProfileGfx old = array.shift(hist)
            deleteProfileGfx(old)

// Finalize a completed session into fixed history.
// If holdAsPrev: keep snap frozen (drawn by Previous NY/ON) — promote on next session end.
finalizeFixedSession(array<ProfileGfx> hist, ProfileSnap frozen, SessAccum acc, bool showHist, bool holdAsPrev) =>
    ProfileSnap newFrozen = frozen
    ProfileSnap snap = buildSnap(acc)
    if not na(snap)
        // Promote prior "previous" session into fixed history (no longer the active previous)
        if showHist and not na(frozen)
            pushHist(hist, frozen)
        newFrozen := holdAsPrev ? snap : na
        if showHist and not holdAsPrev
            pushHist(hist, snap)
    else if not holdAsPrev
        newFrozen := na
    newFrozen

method resetAccum(SessAccum acc) =>
    array.clear(acc.highs)
    array.clear(acc.lows)
    array.clear(acc.vols)

method accumulate(SessAccum acc, bool inSes, bool isNewSes) =>
    if isNewSes
        acc.startIndex := bar_index
        acc.resetAccum()
    if inSes
        array.push(acc.highs, high)
        array.push(acc.lows,  low)
        array.push(acc.vols,  volume)
        acc.endIndex := bar_index

// Fixed NY / ON session profiles
if isEndNY and (showSessNY or showNY)
    nyFrozen := finalizeFixedSession(nyHist, nyFrozen, nyAccum, showSessNY, showNY)
    nyAccum.resetAccum()

if isEndON and (showSessON or showON)
    onFrozen := finalizeFixedSession(onHist, onFrozen, onAccum, showSessON, showON)
    onAccum.resetAccum()

if showSessNY or showNY
    nyAccum.accumulate(inNY, isNewNY)
if showSessON or showON
    onAccum.accumulate(inON, isNewON)

// Clear histories when toggled off
if not showSessNY
    while array.size(nyHist) > 0
        deleteProfileGfx(array.shift(nyHist))
    if not showNY
        nyFrozen := na

if not showSessON
    while array.size(onHist) > 0
        deleteProfileGfx(array.shift(onHist))
    if not showON
        onFrozen := na

// ========================================================================
// PREVIOUS WEEK / NY / ON (labeled, extend.right)
// ========================================================================
method clearGfx(ProfileState state) =>
    if not na(state.fullPoly)
        polyline.delete(state.fullPoly)
        state.fullPoly := na
    if not na(state.vaPoly)
        polyline.delete(state.vaPoly)
        state.vaPoly := na
    if not na(state.pocLine)
        line.delete(state.pocLine)
        state.pocLine := na
    if not na(state.vahLine)
        line.delete(state.vahLine)
        state.vahLine := na
    if not na(state.valLine)
        line.delete(state.valLine)
        state.valLine := na
    if not na(state.pocLabel)
        label.delete(state.pocLabel)
        state.pocLabel := na
    if not na(state.vahLabel)
        label.delete(state.vahLabel)
        state.vahLabel := na
    if not na(state.valLabel)
        label.delete(state.valLabel)
        state.valLabel := na

method processSession(ProfileState state, bool inSes, bool isNewSes, bool isEndSes) =>
    if not state.show
        state.clearGfx()
        array.clear(state.highs)
        array.clear(state.lows)
        array.clear(state.vols)
    else
        if isEndSes
            if array.size(state.highs) > 0
                float dHigh   = array.max(state.highs)
                float dLow    = array.min(state.lows)
                float rowSize = (dHigh - dLow) / state.rowsInput

                if rowSize > 0
                    float[] rowVols = array.new_float(state.rowsInput, 0.0)
                    float totalVol  = 0.0

                    for i = 0 to array.size(state.highs) - 1
                        float h = array.get(state.highs, i)
                        float l = array.get(state.lows,  i)
                        float v = array.get(state.vols,  i)

                        int startRow    = math.max(0, math.floor((l - dLow) / rowSize))
                        int endRow      = math.min(state.rowsInput - 1, math.floor((h - dLow) / rowSize))
                        int rowsSpanned = endRow - startRow + 1
                        float volPerRow = rowsSpanned > 0 ? v / rowsSpanned : 0

                        for j = startRow to endRow
                            array.set(rowVols, j, array.get(rowVols, j) + volPerRow)
                            totalVol += volPerRow

                    float maxVol = 0.0
                    int   pocRow = 0
                    for j = 0 to state.rowsInput - 1
                        float vol = array.get(rowVols, j)
                        if vol > maxVol
                            maxVol := vol
                            pocRow := j

                    float vaTargetVol  = totalVol * (state.vaPct / 100.0)
                    float currentVaVol = array.get(rowVols, pocRow)
                    int upperRow = pocRow
                    int lowerRow = pocRow

                    while currentVaVol < vaTargetVol and (upperRow < state.rowsInput - 1 or lowerRow > 0)
                        float upperVol = upperRow < state.rowsInput - 1 ? array.get(rowVols, upperRow + 1) : -1.0
                        float lowerVol = lowerRow > 0 ? array.get(rowVols, lowerRow - 1) : -1.0
                        if upperVol >= lowerVol and upperVol != -1.0
                            upperRow += 1
                            currentVaVol += upperVol
                        else if lowerVol != -1.0
                            lowerRow -= 1
                            currentVaVol += lowerVol

                    float pocPrice = dLow + (pocRow * rowSize) + (rowSize / 2)
                    float vahPrice = dLow + (upperRow * rowSize) + (rowSize / 2)
                    float valPrice = dLow + (lowerRow * rowSize) + (rowSize / 2)

                    int   dayLength    = state.endIndex - state.startIndex + 1
                    float maxWidthBars = dayLength * (state.widthPct / 100.0)

                    state.clearGfx()

                    chart.point[] points = array.new<chart.point>()
                    array.push(points, chart.point.from_index(state.startIndex, dLow))
                    for j = 0 to state.rowsInput - 1
                        float price = dLow + (j * rowSize)
                        float vol   = array.get(rowVols, j)
                        int xOffset = math.round((vol / maxVol) * maxWidthBars)
                        array.push(points, chart.point.from_index(state.startIndex + xOffset, price))
                    array.push(points, chart.point.from_index(state.startIndex, dHigh))
                    array.push(points, chart.point.from_index(state.startIndex, dLow))
                    state.fullPoly := polyline.new(points, line_color=state.profColor, closed=true)

                    if upperRow >= lowerRow
                        chart.point[] vaPoints = array.new<chart.point>()
                        array.push(vaPoints, chart.point.from_index(state.startIndex, valPrice))
                        for j = lowerRow to upperRow
                            float price = dLow + (j * rowSize)
                            float vol   = array.get(rowVols, j)
                            int xOffset = math.round((vol / maxVol) * maxWidthBars)
                            array.push(vaPoints, chart.point.from_index(state.startIndex + xOffset, price))
                        array.push(vaPoints, chart.point.from_index(state.startIndex, vahPrice))
                        array.push(vaPoints, chart.point.from_index(state.startIndex, valPrice))
                        state.vaPoly := polyline.new(vaPoints, line_color=state.vaColor, closed=true, fill_color=color.new(state.vaColor, 85))

                    state.pocLine := line.new(state.startIndex, pocPrice, bar_index, pocPrice, color=state.pocColor, width=2, extend=extend.right)
                    state.vahLine := line.new(state.startIndex, vahPrice, bar_index, vahPrice, color=state.vahColor, width=1, style=line.style_dashed, extend=extend.right)
                    state.valLine := line.new(state.startIndex, valPrice, bar_index, valPrice, color=state.valColor, width=1, style=line.style_dashed, extend=extend.right)

                    string pText = state.name + " POC (" + str.tostring(pocPrice, format.mintick) + ")"
                    string hText = state.name + " VAH (" + str.tostring(vahPrice, format.mintick) + ")"
                    string lText = state.name + " VAL (" + str.tostring(valPrice, format.mintick) + ")"

                    state.pocLabel := label.new(bar_index + state.labelOffset, pocPrice, pText, color=color.new(state.pocColor, 92), textcolor=state.pocColor, style=label.style_label_lower_left, size=size.small)
                    state.vahLabel := label.new(bar_index + state.labelOffset, vahPrice, hText, color=color.new(state.vahColor, 92), textcolor=state.vahColor, style=label.style_label_lower_left, size=size.small)
                    state.valLabel := label.new(bar_index + state.labelOffset, valPrice, lText, color=color.new(state.valColor, 92), textcolor=state.valColor, style=label.style_label_lower_left, size=size.small)

            array.clear(state.highs)
            array.clear(state.lows)
            array.clear(state.vols)

        if isNewSes
            state.startIndex := bar_index
            array.clear(state.highs)
            array.clear(state.lows)
            array.clear(state.vols)

        if inSes
            array.push(state.highs, high)
            array.push(state.lows,  low)
            array.push(state.vols,  volume)
            state.endIndex := bar_index

        if not na(state.pocLabel)
            label.set_x(state.pocLabel, bar_index + state.labelOffset)
        if not na(state.vahLabel)
            label.set_x(state.vahLabel, bar_index + state.labelOffset)
        if not na(state.valLabel)
            label.set_x(state.valLabel, bar_index + state.labelOffset)

wkState.processSession(inWeek, isNewWeek, isEndWeek)
nyState.processSession(inNY,   isNewNY,   isEndNY)
onState.processSession(inON,   isNewON,   isEndON)

// ========================================================================
// SESSION BOXES
// ========================================================================
method updateBox(SessionBox sb, bool show, bool inSes, bool isNewSes, color bgColor, color borderColor) =>
    if show and isNewSes
        sb.h        := high
        sb.l        := low
        sb.startIdx := bar_index
        sb.b        := box.new(sb.startIdx, sb.h, bar_index, sb.l, border_color=borderColor, bgcolor=bgColor)

    if show and inSes and not isNewSes
        sb.h := math.max(sb.h, high)
        sb.l := math.min(sb.l, low)
        if not na(sb.b)
            box.set_top(sb.b,    sb.h)
            box.set_bottom(sb.b, sb.l)
            box.set_right(sb.b,  bar_index)

bool inNY_box    = not na(time(timeframe.period, nySession, tzInput))
bool isNewNY_box = inNY_box and not inNY_box[1]
nyBoxState.updateBox(showNyBox, inNY_box, isNewNY_box, nyBoxColor, nyBoxBorder)

bool inON_box    = not na(time(timeframe.period, onSession, tzInput))
bool isNewON_box = inON_box and not inON_box[1]
onBoxState.updateBox(showOnBox, inON_box, isNewON_box, onBoxColor, onBoxBorder)

bool inLN_box    = not na(time(timeframe.period, lnSession, tzInput))
bool isNewLN_box = inLN_box and not inLN_box[1]
lnBoxState.updateBox(showLnBox, inLN_box, isNewLN_box, lnBoxColor, lnBoxBorder)

bool inAS_box    = not na(time(timeframe.period, asSession, tzInput))
bool isNewAS_box = inAS_box and not inAS_box[1]
asBoxState.updateBox(showAsBox, inAS_box, isNewAS_box, asBoxColor, asBoxBorder)
