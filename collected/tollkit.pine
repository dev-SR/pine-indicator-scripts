// upflagUpFrontier4 := upflagUpFrontier4 and (high[n+1] <= high[n] and 
high[n+2] <= high[n] and high[n+3] <= high[n] and high[n+4] <= high[n] and high[n+i
+ 4] < high[n])
// flagUpFrontier = upflagUpFrontier0 or upflagUpFrontier1 or upflagUpFrontier2 or 
upflagUpFrontier3 or upflagUpFrontier4
// upFractal = (upflagmasterdownFrontier and flagUpFrontier)
// // masterdownFractal
// bool masterdownflagmasterdownFrontier = true
// bool masterdownflagUpFrontier0 = true
// bool masterdownflagUpFrontier1 = true
// bool masterdownflagUpFrontier2 = true
// bool masterdownflagUpFrontier3 = true
// bool masterdownflagUpFrontier4 = true
// for i = 1 to n
// masterdownflagmasterdownFrontier := masterdownflagmasterdownFrontier and 
(low[n-i] > low[n])
// masterdownflagUpFrontier0 := masterdownflagUpFrontier0 and (low[n+i] > 
low[n])
// masterdownflagUpFrontier1 := masterdownflagUpFrontier1 and (low[n+1] >= 
low[n] and low[n+i + 1] > low[n])
// masterdownflagUpFrontier2 := masterdownflagUpFrontier2 and (low[n+1] >= 
low[n] and low[n+2] >= low[n] and low[n+i + 2] > low[n])
// masterdownflagUpFrontier3 := masterdownflagUpFrontier3 and (low[n+1] >= 
low[n] and low[n+2] >= low[n] and low[n+3] >= low[n] and low[n+i + 3] > low[n])
// masterdownflagUpFrontier4 := masterdownflagUpFrontier4 and (low[n+1] >= 
low[n] and low[n+2] >= low[n] and low[n+3] >= low[n] and low[n+4] >= low[n] and 
low[n+i + 4] > low[n])
// flagmasterdownFrontier = masterdownflagUpFrontier0 or masterdownflagUpFrontier1 
or masterdownflagUpFrontier2 or masterdownflagUpFrontier3 or 
masterdownflagUpFrontier4
