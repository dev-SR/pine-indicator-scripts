if barstate.isconfirmed
    if ticker1CrossOver
        label.new(bar_index, close, str.tostring(ticker1EMA1Length) + " + " + str.tostring(ticker1EMA2Length) + "\n" + convertTimeToStrCompact(timeframe.in_seconds(ticker1TF) * 1000), style = label.style_label_down, size = size.normal, yloc = yloc.belowbar, textcolor = bullishColor, color=color.rgb(0, 0, 0, 100))

    if ticker1CrossUnder
        label.new(bar_index, close, str.tostring(ticker1EMA1Length) + " + " + str.tostring(ticker1EMA2Length) + "\n" + convertTimeToStrCompact(timeframe.in_seconds(ticker1TF) * 1000), style = label.style_label_up, size = size.normal, yloc = yloc.abovebar, textcolor = bearishColor, color=color.rgb(0, 0, 0, 100))
    
    if ticker2CrossOver
