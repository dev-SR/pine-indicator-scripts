    ticker1Enabled := ticker1EnabledCustom

    ticker2 := ticker2Custom
    ticker2TF := ticker2TFCustom
    ticker2Enabled := ticker2EnabledCustom

    ticker3 := ticker3Custom
    ticker3TF := ticker3TFCustom
    ticker3Enabled := ticker3EnabledCustom

    ticker4 := ticker4Custom
    ticker4TF := ticker4TFCustom
    ticker4Enabled := ticker4EnabledCustom

    ticker5 := ticker5Custom
    ticker5TF := ticker5TFCustom
    ticker5Enabled := ticker5EnabledCustom

var tickerInfo[] tickerInfos = array.from(tickerInfo.new(1, ticker1, ticker1TF, ticker1EMA1Length, ticker1EMA2Length, ticker1Enabled), tickerInfo.new(2, ticker2, ticker2TF, ticker2EMA1Length, ticker2EMA2Length, ticker2Enabled), tickerInfo.new(3, ticker3, ticker3TF, ticker3EMA1Length, ticker3EMA2Length, ticker3Enabled), tickerInfo.new(4, ticker4, ticker4TF, ticker4EMA1Length, ticker4EMA2Length, ticker4Enabled), tickerInfo.new(5, ticker5, ticker5TF, ticker5EMA1Length, ticker5EMA2Length, ticker5Enabled))

isTimeframeLower (timeframe1F, timeframe2F) =>
    timeframe.in_seconds(timeframe1F) < timeframe.in_seconds(timeframe2F)

getMinTimeframe (timeframe1F, timeframe2F) =>
    if isTimeframeLower(timeframe1F, timeframe2F)
        timeframe1F
    else
        timeframe2F

getMaxTimeframe (timeframe1F, timeframe2F) =>
    if isTimeframeLower(timeframe1F, timeframe2F)
        timeframe2F
    else
        timeframe1F

formatTimeframeString (formatTimeframe) =>
    timeframeF = formatTimeframe == "" ? timeframe.period : formatTimeframe
    
    if str.contains(timeframeF, "D") or str.contains(timeframeF, "W") or str.contains(timeframeF, "S") or str.contains(timeframeF, "M")
        timeframeF
    else
        seconds = timeframe.in_seconds(timeframeF)
        if seconds >= 3600
            hourCount = int(seconds / 3600)
            str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
        else
            timeframeF + " Min"

getData (tickerInfo tickerInfoF, simple string symbolF, simple string timeframeF, simple int length1, simple int length2) =>
    [ema1F, ema2F, closeF, atrF] = request.security(ticker.standard(symbolF), timeframeF, [str.tostring(ta.ema(EMASource, length1), format.mintick), str.tostring(ta.ema(EMASource, length2), format.mintick), str.tostring(close, format.mintick), atr])
    [ema1F, ema2F, closeF, atrF]

getTFData(tickerInfo tickerInfoF, simple string symbolF, simple string timeframeF, simple int length1, simple int length2) =>
    if tickerInfoF.isEnabled
        getData(tickerInfoF, symbolF, timeframeF, length1, length2)
    else
        [na, na, na, na]


[ema1Ticker1, ema2Ticker1, closeTicker1, atrTicker1] = getTFData(tickerInfos.get(0), ticker1, ticker1TF, ticker1EMA1Length, ticker1EMA2Length)
tickerInfo1 = tickerInfos.get(0)
tickerInfo1.ema1 := ema1Ticker1
tickerInfo1.ema2 := ema2Ticker1
tickerInfo1.closeF := closeTicker1
tickerInfo1.atrF := atrTicker1
var lastCrossTicker1 = customCross.new()
ticker1CrossOver = ta.crossover(str.tonumber(ema1Ticker1), str.tonumber(ema2Ticker1))
ticker1CrossUnder = ta.crossunder(str.tonumber(ema1Ticker1), str.tonumber(ema2Ticker1))
if ticker1CrossOver
    lastCrossTicker1.lastTime := time
    lastCrossTicker1.upCross := true

if ticker1CrossUnder
    lastCrossTicker1.lastTime := time
    lastCrossTicker1.upCross := false
tickerInfo1.lastCross := lastCrossTicker1

