const bool DEBUG = false
const int maxBoxesCount = 500
const int lastXMarketStructures = 10
const int maxDistanceToLastBar = 750 // Affects Running Time
const int atrLen = 10

indicator(title = 'EMA Cross Dashboard | Flux Charts', overlay = true, max_boxes_count = maxBoxesCount, max_labels_count = maxBoxesCount, max_lines_count = maxBoxesCount, max_bars_back = 100)

tickersPreset = DEBUG ? input.string("Crypto", "", options = ["Crypto", "Stocks", "Forex", "Futures", "Custom"], inline = "a", group = "Timeframes", display = display.none) : "Custom"
overrideTF = DEBUG ? input.timeframe("", "", group = "Timeframes", inline = "a", display = display.none) : ""

//warning = input.color(color.black, "Please only select timeframes >= than the current chart.", group = "Timeframes", inline = "warning", display = display.none)

