handleDashboard () =>
    // Header
    colIndex = 0
    EMA1Start = 0
    EMA2Start = 0
    crossStart = 0
    
    table.cell(screener, 0, 0, "EMA Cross Dashboard | Flux Charts", text_color = textColor, bgcolor = screenerColor)

    // Legend

    table.cell(screener, colIndex, 1, "Timeframe", text_color = textColor, bgcolor = screenerColor)
    colIndex += 1

    if true
        EMA1Start := colIndex
        table.cell(screener, EMA1Start, 1, "EMA 1", text_color = textColor, bgcolor = screenerColor)
        colIndex += 1

        EMA2Start := colIndex
        table.cell(screener, EMA2Start, 1, "EMA 2", text_color = textColor, bgcolor = screenerColor)
        colIndex += 1

        crossStart := colIndex
        table.cell(screener, crossStart, 1, "Cross", text_color = textColor, bgcolor = screenerColor)
        colIndex += 1

    table.merge_cells(screener, 0, 0, colIndex - 1, 0)

    // Tickers
    tickerStart = 2
    i = 0
    for a = 0 to tickerInfos.size() - 1
        curTickerInfo = tickerInfos.get(a)
        if curTickerInfo.isEnabled == false
            continue

        // Dashboard
        table.cell(screener, 0, tickerStart + i, str.tostring(formatTimeframeString(curTickerInfo.timeframeStr)) + " 🕒", text_color = textColor, bgcolor = screenerColor)

        if true
            priceDiff = (str.tonumber(curTickerInfo.ema1) > str.tonumber(curTickerInfo.ema2) ? ">" : str.tonumber(curTickerInfo.ema1) < str.tonumber(curTickerInfo.ema2) ? "<" : "=")
            bgColor = screenerColor
            if fillBackgrounds
                bgColor := (priceDiff == ">" ? bullishColor : priceDiff == "<" ? bearishColor : screenerColor)
            table.cell(screener, EMA1Start, tickerStart + i, str.tostring(curTickerInfo.length1), text_color = textColor, bgcolor = bgColor)
            table.cell(screener, EMA2Start, tickerStart + i, str.tostring(curTickerInfo.length2), text_color = textColor, bgcolor = bgColor)

            crossText = "None"
            if not na(curTickerInfo.lastCross)
                crossText := curTickerInfo.lastCross.upCross ? "" : ""
                timeText = convertTimeToStr(time - curTickerInfo.lastCross.lastTime) + " Ago"
                if timeText == "0 Min Ago"
                    timeText := "Now"
                if timeText == "NaN Min Ago"
                    timeText := "None"
                //crossText += " " + timeText
                crossText := timeText
            table.cell(screener, crossStart, tickerStart + i, crossText, text_color = textColor, bgcolor = bgColor)
        i += 1

if displayDashboard
    handleDashboard()