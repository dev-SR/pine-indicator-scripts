ticker5Color = DEBUG ? input.color(color.purple, "", group = "Timeframes", inline = "5", display = display.none) : color.purple
//

EMASource = input.source(close, "EMA Source", group = "General Configuration", display = display.none)
displayDashboard = input.bool(true, "Display Dashboard", group = "General Configuration", inline = "display", display = display.none)
plotCrosses = input.bool(true, "Crosses", group = "General Configuration", inline = "display", display = display.none)
plotLines = DEBUG ? input.bool(false, "Lines", group = "General Configuration", inline = "display", display = display.none) : false

screenerPosition = input.string("Top Center", "Position", options = ["Top Right", "Top Center", "Right Center", "Middle Center", "Left Center", "Bottom Center"], group = "Style", display = display.none)
fillBackgrounds = input.bool(true, "Fill Backgrounds", group = "Style", display = display.none)
screenerColor = input.color(#1B1F2B, 'Background', group = 'Style', inline = "1", display = display.none)
frameColor = input.color(color.rgb(255, 255, 255), 'Frame', inline = "1", group = 'Style', display = display.none)
borderColor = input.color(color.rgb(255, 255, 255), 'Border', inline = "2", group = 'Style', display = display.none)
textColor = input.color(color.white, 'Text', group = 'Style', inline = "2", display = display.none)
bullishColor = input.color(#089981, 'Bullish', inline = 'obColor', group = 'Style', display = display.none)
bearishColor = input.color(#ff5252, 'Bearish', inline = 'obColor', group = 'Style', display = display.none)

atr = ta.atr(atrLen)

getPosition (positionText) =>
    if positionText == "Top Right"
        position.top_right
    else if positionText == "Top Center"
        position.top_center
    else if positionText == "Right Center"
        position.middle_right
    else if positionText == "Left Center"
        position.middle_left
    else if positionText == "Bottom Center"
        position.bottom_center
    else if positionText == "Middle Center"
        position.middle_center

convertTimeToStr (ms) =>
    seconds = int(ms / 1000)
    if seconds >= 86400
        daysCount = int(seconds / 86400)
        str.tostring(daysCount) + " Day" + (daysCount > 1 ? "s" : "")
    else if seconds >= 3600
        hourCount = int(seconds / 3600)
        str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
    else
        minCount = int(seconds / 60)
        str.tostring(minCount) + " Min" + (minCount > 1 ? "s" : "")

convertTimeToStrCompact (ms) =>
    seconds = int(ms / 1000)
    if seconds >= 86400
        daysCount = int(seconds / 86400)
        str.tostring(daysCount) + "d" + (daysCount > 1 ? "" : "")
    else if seconds >= 3600
        hourCount = int(seconds / 3600)
        str.tostring(hourCount) + "h" + (hourCount > 1 ? "" : "")
    else
        minCount = int(seconds / 60)
        str.tostring(minCount) + "m" + (minCount > 1 ? "" : "")

var table screener = table.new(getPosition(screenerPosition), 40, 40, bgcolor = screenerColor, frame_width = 2, frame_color = frameColor, border_width = 1, border_color = borderColor)

type customCross
    int lastTime = na
    bool upCross = false

type tickerInfo
    int index = na
    string symbol
    string timeframeStr = na
    int length1 = na
    int length2 = na
    bool isEnabled = false

    string ema1
    string ema2
    string closeF
    float atrF
    customCross lastCross

ticker1 = ""
ticker1TF = overrideTF
ticker1Enabled = true

ticker2 = ""
ticker2TF = overrideTF
ticker2Enabled = true

ticker3 = ""
ticker3TF = overrideTF
ticker3Enabled = true

ticker4 = ""
ticker4TF = overrideTF
ticker4Enabled = true

ticker5 = ""
ticker5TF = overrideTF
ticker5Enabled = true

if tickersPreset == "Crypto"
    ticker1 := "BINANCE:BTCUSDT"
    ticker2 := "BINANCE:ETHUSDT"
    ticker3 := "BINANCE:SOLUSDT"
    ticker4 := "BINANCE:XRPUSDT"
    ticker5 := "BINANCE:ADAUSDT"
else if tickersPreset == "Stocks"
    ticker1 := "NASDAQ:AAPL"
    ticker2 := "NASDAQ:TSLA"
    ticker3 := "NASDAQ:NVDA"
    ticker4 := "PYTH:SPY"
    ticker5 := "NASDAQ:QQQ"
else if tickersPreset == "Forex"
    ticker1 := "OANDA:EURUSD"
    ticker2 := "OANDA:GBPUSD"
    ticker3 := "OANDA:USDJPY"
    ticker4 := "OANDA:GBPJPY"
    ticker5 := "OANDA:AUDUSD"
else if tickersPreset == "Futures"
    ticker1 := "CME_MINI:ES1!"
    ticker2 := "CME_MINI:NQ1!"
    ticker3 := "NYMEX:CL1!"
    ticker4 := "COMEX:GC1!"
    ticker5 := "CBOT_MINI:YM1!"
if tickersPreset == "Custom"
    ticker1 := ticker1Custom
