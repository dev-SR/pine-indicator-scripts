//@version=5
const bool DEBUG = false
const int maxBoxesCount = 500
const int maxDistanceToLastBar = 750 // Affects Running Time
const int atrLen = 14
const int deleteUntouchedAfterXBars = 200
const int showLastX = 25

BOSenable = true
CHoCHenable = true
CHoCHPlusenable = true

EQHEnabled = false
EQLEnabled = false
EQPMultiplier = 0.2

indicator(title = 'Market Structures Screener | Flux Charts', overlay = true, max_boxes_count = maxBoxesCount, max_labels_count = maxBoxesCount, max_lines_count = maxBoxesCount, max_bars_back = 5000)

tickersPreset = DEBUG ? input.string("Crypto", "", options = ["Crypto", "Stocks", "Forex", "Futures", "Custom"], inline = "a", group = "Tickers", display = display.none) : "Custom"
